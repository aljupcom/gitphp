APP_NAME=GitPHP
APP_URL=https://git.example.com
APP_OWNER=aljailane

# UI theme (subdirectory of /templates): "github" (default) or "legacy"
APP_THEME=github

# Display timezone (IANA identifier)
APP_TIMEZONE=UTC

# Verbose error output — NEVER enable on production
APP_DEBUG=0

# Set to 1 by the installer; locks the web installer (public_html/install.php)
# APP_INSTALLED=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gitphp
DB_USER=gitphp
DB_PASS=

# Keep one persistent MySQL connection per PHP worker
DB_PERSISTENT=1

# Outbound mail (password reset, verification). Sets the sender address;
# when empty the Mailer logs instead of sending and auto-verifies accounts.
MAIL_FROM=

REPOS_PATH=/home/domain.com/repos
AUTHORIZED_KEYS_PATH=/home/git/.ssh/authorized_keys
OWNER_PASSWORD_HASH=

# Smart Cache & Storage Auto-Cleanup Thresholds
CACHE_MAX_SIZE_MB=50
CACHE_PRUNE_WATERMARK=80
