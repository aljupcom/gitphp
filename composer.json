{
    "name": "aljailane/gitphp",
    "description": "Personal Git hosting platform built with PHP",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.8",
        "league/commonmark": "^2.4",
        "symfony/process": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
