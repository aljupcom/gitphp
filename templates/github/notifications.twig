{% extends "layout.twig" %}

{% block title %}Notifications — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page">
    <div class="gh-page-head">
        <div>
            <h1 class="gh-page-title">Notifications</h1>
            <p class="gh-page-sub">Updates from repositories you watch and reports you submitted.</p>
        </div>
        {% if notifications|length > 0 %}
            <div class="gh-page-actions">
                <form method="POST" action="/notifications/read" class="gh-inline-form">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="gh-btn">
                        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.28 6.78a.75.75 0 0 0-1.06-1.06L7.25 8.69 5.78 7.22a.751.751 0 0 0-1.042.018.751.751 0 0 0-.018 1.042l2 2a.75.75 0 0 0 1.06 0l3.5-3.5Z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0Zm-8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Z"/></svg>
                        <span>Mark all as read</span>
                    </button>
                </form>
            </div>
        {% endif %}
    </div>

    {% if notifications|length > 0 %}
        <div class="gh-activity gh-notifications">
            {% for item in notifications %}
                <div class="gh-activity-item{{ item.is_read ? ' gh-notification-read' : ' gh-notification-unread' }}">
                    <span class="gh-notification-dot" aria-hidden="true"></span>
                    <div class="gh-notification-body">
                        <div class="gh-activity-details">
                            {% if item.link %}
                                <a class="gh-notification-message" href="{{ item.link }}">{{ item.message }}</a>
                            {% else %}
                                <span class="gh-notification-message">{{ item.message }}</span>
                            {% endif %}
                            {% if item.repo_name %}
                                <span class="gh-activity-repo">({{ item.repo_name }})</span>
                            {% endif %}
                        </div>
                        <time class="gh-activity-time" datetime="{{ item.created_at }}">{{ item.created_at|time_ago }}</time>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="gh-empty">
            <svg width="48" height="48" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16a2 2 0 0 0 1.985-1.75c.017-.137-.097-.25-.235-.25h-3.5c-.138 0-.252.113-.235.25A2 2 0 0 0 8 16Z"/><path d="M8 1.5A3.5 3.5 0 0 0 4.5 5v2.947c0 .346-.102.683-.294.97l-1.703 2.556a.018.018 0 0 0-.003.01l.001.006c0 .002.002.004.004.006a.017.017 0 0 0 .005.004l.008.001h10.964l.008-.001a.016.016 0 0 0 .005-.004.016.016 0 0 0 .004-.006l.001-.007a.017.017 0 0 0-.003-.01l-1.703-2.554a1.75 1.75 0 0 1-.294-.97V5A3.5 3.5 0 0 0 8 1.5ZM3 5a5 5 0 0 1 10 0v2.947c0 .05.015.098.042.139l1.703 2.555A1.518 1.518 0 0 1 13.482 13H2.518a1.518 1.518 0 0 1-1.263-2.36l1.703-2.554A.25.25 0 0 0 3 7.947Z"/></svg>
            <h2>No notifications</h2>
            <p>Watch a repository to receive updates when new commits are pushed.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
