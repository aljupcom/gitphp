<section id="installation" class="gh-docs-section" style="border: 2px solid rgba(31,111,235,0.4); background: linear-gradient(180deg, rgba(31,111,235,0.03) 0%, transparent 100%); border-radius:10px; padding:1.75rem; margin-bottom:2rem;">
