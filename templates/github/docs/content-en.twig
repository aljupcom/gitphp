{# ── 4. Git HTTP ── #}
{% if current_cat == 'all' or 'git-http' in allowed %}
<section id="git-http" class="gh-docs-section">
    <h2><span class="gh-docs-num">4</span> Pushing and Cloning over HTTP (Standard Password)</h2>
    <h3>a) Push an existing local project</h3>
<pre class="gh-docs-code" dir="ltr"><code>cd my-project
git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin {{ app_url }}/{{ owner }}/my-project.git
