<!DOCTYPE html>
<html lang="{{ current_locale|default('en') }}" dir="{{ dir|default('ltr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Accept-CH" content="Sec-CH-UA, Sec-CH-UA-Mobile, Sec-CH-UA-Platform, Sec-CH-UA-Platform-Version, Sec-CH-UA-Model, Sec-CH-UA-Arch, Sec-CH-UA-Bitness">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    {# Apply saved/system color scheme before first paint (CSP-safe external file). #}
    <script src="{{ asset('assets/js/theme.js') }}"></script>
        {# Preload essential fonts locally to eliminate layout shift / font flashing #}
    <link rel="preload" href="/assets/fonts/vazirmatn-13-Dxxo8j6PP2D_kU2muijlGMWWIGroe7ll.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/inter-6-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/jetbrains-mono-12-tDbv2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKwBNntkaToggR7BYRbKPxDcwgknk-4.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('assets/css/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/wap.css') }}">
    {% block head %}{% endblock %}
</head>
<body>
    {% include "partials/tabler-sprite.twig" %}
        <header class="gh-header">
        <div class="gh-header-inner">
            
            {# Left side: Hamburger (mobile only) + Octocat Logo + Nav links (desktop) #}
            <div class="gh-header-left">
                <button type="button" id="gh-header-toggle" class="gh-header-toggle"  aria-label="Open navigation menu"
                        aria-expanded="false" aria-controls="gh-drawer">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.75A.75.75 0 0 1 1.75 2h12.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1.75 2.75Zm0 5A.75.75 0 0 1 1.75 7h12.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1 7.75ZM1.75 12h12.5a.75.75 0 0 1 0 1.5H1.75a.75.75 0 0 1 0-1.5Z"/></svg>
                </button>

                <a class="gh-logo" href="/" aria-label="{{ app_name }} home" style="display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 16px; flex-shrink: 0;">
                    {% include "partials/logo.twig" with { size: 30, radius: 7 } %}
                    {% include "partials/brand-name.twig" %}
                </a>

                <nav class="gh-header-nav-links">
                    <a class="gh-header-link" href="/">{{ t('ui.nav.home') }}</a>
                    <a class="gh-header-link" href="/docs">{{ t('ui.nav.docs') }}</a>
                    {% if is_logged_in and (is_owner or is_staff or is_auditor) %}
                        <a class="gh-header-link" href="{{ admin_prefix|default('/admin') }}" style="color: #58a6ff; font-weight: 600;">{{ t('ui.nav.admin') }}</a>
                    {% endif %}
                </nav>
            </div>

            {# Center: Search Input Bar #}
            <div class="gh-header-search-wrap">
                <form method="GET" action="/search" class="gh-search" role="search" id="gh-search-form" style="position: relative; width: 100%;">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="var(--gh-fg-muted, #8b949e)" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); pointer-events: none;"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
                    <input id="gh-search-input" type="search" name="q" placeholder="{{ t_attr('ui.repo.find_repo') }}"
                           aria-label="Search repositories, code, issues, users" autocomplete="off" aria-controls="gh-search-dd"
                           style="width: 100%; padding: 6px 36px 6px 32px; font-size: 13px; background: var(--gh-bg-canvas, #ffffff); color: var(--gh-fg-default, #1f2328); border: 1px solid var(--gh-border-default, #d0d7de); border-radius: 6px; outline: none; transition: border-color 0.15s ease, box-shadow 0.15s ease;">
                    <kbd class="gh-search-kbd" aria-hidden="true" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 11px; padding: 1px 5px; border-radius: 4px; border: 1px solid var(--gh-border-default, #30363d); background: var(--gh-bg-subtle, #161b22); color: var(--gh-fg-muted, #8b949e); pointer-events: none;">/</kbd>
                    <div class="gh-search-dd" id="gh-search-dd" role="listbox" hidden></div>
                </form>
            </div>

            {# Right side: Quick Add (+) + Notifications + Theme Toggle + User Avatar Menu #}
            <div class="gh-header-actions">
                
                {# Quick Create Dropdown #}
                {% if is_logged_in %}
                    <div class="gh-create-dd" style="position: relative;">
                        <button type="button" class="gh-icon-btn" id="gh-create-btn" title="{{ t_attr('ui.nav.new_repo') }}" aria-label="{{ t_attr('ui.nav.new_repo') }}"
                                aria-haspopup="true" aria-expanded="false" aria-controls="gh-create-menu"
                                style="gap: 3px; display: inline-flex; align-items: center; justify-content: center; width: auto; padding: 0 8px; height: 32px;">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M7.75 2a.75.75 0 0 1 .75.75V7h4.25a.75.75 0 0 1 0 1.5H8.5v4.25a.75.75 0 0 1-1.5 0V8.5H2.75a.75.75 0 0 1 0-1.5H7V2.75A.75.75 0 0 1 7.75 2Z"/></svg>
                            <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor"><path d="m4.427 7.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 7H4.604a.25.25 0 0 0-.177.427Z"/></svg>
                        </button>
                        <div class="gh-create-menu" id="gh-create-menu" role="menu" aria-label="Create menu">
                            <a href="/repos/new" role="menuitem">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
                                <span>{{ t('ui.nav.new_repo') }}</span>
                            </a>
                            <a href="/repos/import" role="menuitem">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14ZM7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
                                <span>{{ t('ui.nav.import_repo') }}</span>
                            </a>
                        </div>
                    </div>
                {% endif %}

                {# Notifications Button #}
                {% if is_logged_in and not is_owner %}
                    <a class="gh-notification-btn" href="/notifications"
                       aria-label="Notifications{% if unread_notifications %} — {{ unread_notifications }} unread{% endif %}"
                       title="Notifications"
                       style="position: relative;">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16a2 2 0 0 0 1.985-1.75c.011-.143-.09-.25-.235-.25h-3.5c-.145 0-.246.107-.235.25A2 2 0 0 0 8 16ZM3 5a5 5 0 0 1 10 0v2.947c0 .05.015.098.042.139l1.637 2.455A1.25 1.25 0 0 1 13.637 12.5H2.363a1.25 1.25 0 0 1-1.042-1.959l1.637-2.455A.25.25 0 0 0 3 7.947V5Z"/></svg>
                        {% if unread_notifications %}
                            <span class="gh-notification-badge" style="position: absolute; top: -4px; right: -4px; width: 14px; height: 14px; border-radius: 50%; background: #1f6feb; color: #ffffff; font-size: 9px; font-weight: 700; display: flex; align-items: center; justify-content: center;">{{ unread_notifications }}</span>
                        {% endif %}
                    </a>
                {% endif %}

                {# Language Switcher Dropdown #}
                <div class="gh-lang-dd" style="position: relative;">
                    <button type="button" class="gh-icon-btn" id="gh-lang-btn" title="Switch Language" aria-label="Switch Language"
                            style="gap: 4px; display: inline-flex; align-items: center; justify-content: center; width: auto; padding: 0 8px; height: 32px; font-size: 12px; font-weight: 600;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                        <span style="text-transform: uppercase;">{{ current_locale|default('en') }}</span>
                    </button>
                    <div class="gh-create-menu" id="gh-lang-menu" role="menu" aria-label="Select language" style="min-width: 140px; right: 0;">
                        {% for code, langMeta in installed_locales|default({}) %}
                            {% if langMeta.active %}
                                <a href="/lang/{{ code }}" role="menuitem" style="display:flex; justify-content:space-between; align-items:center; {{ current_locale == code ? 'font-weight:700; color:var(--gh-accent-fg, #58a6ff);' : '' }}">
                                    <span>{{ langMeta.native_name }}</span>
                                    {% if current_locale == code %}<svg class="ti ti-check" width="14" height="14"><use href="#ti-check"/></svg>{% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                {# Theme Toggle #}
                <button type="button" id="gh-theme-btn" class="gh-theme-toggle" aria-label="Switch color theme" title="Switch color theme">
                    <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.06-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3.669 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-1.06 1.06L3.67 3.404a.75.75 0 0 1 0-1.061Zm9.192 9.192a.75.75 0 0 1 1.06 0l1.061 1.06a.749.749 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM16 8a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8ZM3.404 2.343a.75.75 0 0 1 0 1.061l-1.06 1.06a.751.751 0 0 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.06 0Zm9.193 9.192a.75.75 0 0 1 0 1.061l1.06 1.061a.749.749 0 0 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.06ZM8 13.25a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V14a.75.75 0 0 1 .75-.75Zm4.596-1.747a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.061ZM4.25 8a.75.75 0 0 1-.75.75H2a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 .75.75Z"/></svg>
                    <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"/></svg>
                </button>

                {# User Avatar Dropdown or Login buttons #}
                {% if is_logged_in %}
                    <div class="gh-user-dd" style="position: relative;">
                        <button type="button" id="gh-user-btn" class="gh-avatar"
                                title="{{ current_user ~ ' — account menu' }}"
                                aria-haspopup="true" aria-expanded="false" aria-controls="gh-user-menu"
                                style="width: 32px; height: 32px; padding: 0; overflow: hidden; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1.5px solid var(--gh-border-default, #30363d); background: #21262d; color: #ffffff; cursor: pointer;">
                            {% if current_avatar %}
                                <img src="{{ current_avatar }}" alt="{{ current_user }}" style="width: 100%; height: 100%; object-fit: cover;">
                            {% else %}
                                {{ (current_user ? current_user : app_name)|avatar_letter }}
                            {% endif %}
                        </button>
                        <div class="gh-user-panel" id="gh-user-menu" role="menu" aria-label="Account menu">
                            <div class="gh-user-head">
                                <div style="font-size: 11px; color: var(--gh-fg-muted, #8b949e);">Signed in as</div>
                                <strong style="font-size: 13px; color: var(--gh-fg-default, #f0f6fc);">{{ current_user ?? app_name }}</strong>
                            </div>
                            <div class="gh-user-links">
                                <a href="/{{ current_user ?? 'admin' }}" role="menuitem">
                                    <svg class="ti ti-user"><use href="#ti-user"/></svg> {{ t('ui.nav.profile') }}
                                </a>
                                <a href="/{{ current_user ?? 'admin' }}?tab=repositories" role="menuitem">
                                    <svg class="ti ti-box"><use href="#ti-box"/></svg> {{ t('ui.nav.repositories') }}
                                </a>
                                <a href="/{{ current_user ?? 'admin' }}?tab=stars" role="menuitem">
                                    <svg class="ti ti-star"><use href="#ti-star"/></svg> {{ t('ui.repo.stars') }}
                                </a>
                                <div class="gh-user-divider"></div>
                                <a href="/repos/new" role="menuitem">
                                    <svg class="ti ti-plus"><use href="#ti-plus"/></svg> {{ t('ui.nav.new_repo') }}
                                </a>
                                <a href="/repos/import" role="menuitem">
                                    <svg class="ti ti-download"><use href="#ti-download"/></svg> {{ t('ui.nav.import_repo') }}
                                </a>
                                <div class="gh-user-divider"></div>
                                <a href="/settings/account" role="menuitem">
                                    <svg class="ti ti-settings"><use href="#ti-settings"/></svg> {{ t('ui.nav.settings') }}
                                </a>
                                <a href="/settings/tokens" role="menuitem">
                                    <svg class="ti ti-bolt"><use href="#ti-bolt"/></svg> {{ t('ui.nav.access_tokens') }}
                                </a>
                                {% if is_owner %}
                                    <div class="gh-user-divider"></div>
                                    <a href="{{ admin_prefix|default('/admin') }}" role="menuitem" style="color: #58a6ff; font-weight: 600;">
                                        <svg class="ti ti-server-2"><use href="#ti-server-2"/></svg> {{ t('ui.nav.admin') }}
                                    </a>
                                {% endif %}
                                <div class="gh-user-divider"></div>
                                <a class="gh-user-danger" href="/logout" role="menuitem">
                                    <svg class="ti ti-logout"><use href="#ti-logout"/></svg> {{ t('ui.nav.sign_out') }}
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <a class="gh-btn gh-btn-sm" href="/register" style="font-size: 13px; padding: 4px 10px;">{{ t('ui.nav.sign_up') }}</a>
                    <a class="gh-btn gh-btn-primary gh-btn-sm" href="/login" style="font-size: 13px; padding: 4px 10px;">{{ t('ui.nav.sign_in') }}</a>
                {% endif %}
            </div>
        </div>
    </header>

    {% if enforce_2fa_alert %}
        <div style="background: rgba(248,81,73,0.12); border-bottom: 1px solid rgba(248,81,73,0.3); color: #f85149; padding: 9px 16px; font-size: 13px; display: flex; align-items: center; justify-content: space-between; gap: 12px; z-index: 999; position: relative;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg class="ti ti-shield-lock" style="font-size: 16px;"><use href="#ti-shield-lock"/></svg>
                <span><strong>Security Policy:</strong> Two-Factor Authentication (2FA) is required for your account. Please configure 2FA to protect your account.</span>
            </div>
            <a href="/settings/account?tab=security" class="gh-btn gh-btn-sm" style="background: #da3633; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 12px; padding: 3px 10px;">Enable 2FA</a>
        </div>
    {% endif %}

    {# Mobile drawer navigation (GitHub-style slide-in menu) #}
    <nav id="gh-drawer" class="gh-drawer" aria-label="Global navigation">
        <div class="gh-drawer-backdrop" data-drawer-close ></div>
        <div class="gh-drawer-panel">
            <div class="gh-drawer-head">
                <a class="gh-logo" href="/" style="display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-size: 15px;">
                    {% include "partials/logo.twig" with { size: 26, radius: 6 } %}
                    {% include "partials/brand-name.twig" %}
                </a>
                <div class="gh-drawer-actions">
                    <button type="button" class="gh-icon-btn gh-theme-toggle" aria-label="Switch color theme" title="Switch color theme">
                        <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.06-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3.669 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-1.06 1.06L3.67 3.404a.75.75 0 0 1 0-1.061Zm9.192 9.192a.75.75 0 0 1 1.06 0l1.061 1.06a.749.749 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM16 8a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8ZM3.404 2.343a.75.75 0 0 1 0 1.061l-1.06 1.06a.751.751 0 0 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.06 0Zm9.193 9.192a.75.75 0 0 1 0 1.061l1.06 1.061a.749.749 0 0 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.06ZM8 13.25a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V14a.75.75 0 0 1 .75-.75Zm4.596-1.747a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.061ZM4.25 8a.75.75 0 0 1-.75.75H2a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 .75.75Z"/></svg>
                        <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"/></svg>
                    </button>
                    <button type="button" class="gh-icon-btn" aria-label="Close menu" data-drawer-close >
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"/></svg>
                    </button>
                </div>
            </div>
            <div class="gh-drawer-links">
                <a href="/"><svg class="ti ti-home"><use href="#ti-home"/></svg> {{ t('ui.nav.home') }}</a>
                <a href="/docs"><svg class="ti ti-book"><use href="#ti-book"/></svg> {{ t('ui.nav.docs') }}</a>
                {% if is_logged_in %}
                    <div style="height: 1px; background: var(--gh-border-default, #30363d); margin: 6px 8px;"></div>
                    {% if is_owner %}
                        <a href="{{ admin_prefix|default('/admin') }}"><svg class="ti ti-server-2"><use href="#ti-server-2"/></svg> {{ t('ui.nav.admin') }}</a>
                        <a href="/admin/repos/create"><svg class="ti ti-plus"><use href="#ti-plus"/></svg> {{ t('ui.nav.new_repo') }}</a>
                        <a href="/admin/ssh-keys"><svg class="ti ti-key"><use href="#ti-key"/></svg> {{ t('ui.footer.git_ssh') }}</a>
                    {% else %}
                        <a href="/{{ current_user ?? 'admin' }}?tab=repositories"><svg class="ti ti-box"><use href="#ti-box"/></svg> {{ t('ui.nav.repositories') }}</a>
                        <a href="/repos/new"><svg class="ti ti-plus"><use href="#ti-plus"/></svg> {{ t('ui.nav.new_repo') }}</a>
                        <a href="/repos/import"><svg class="ti ti-download"><use href="#ti-download"/></svg> {{ t('ui.nav.import_repo') }}</a>
                        <a href="/settings/tokens"><svg class="ti ti-key"><use href="#ti-key"/></svg> {{ t('ui.nav.access_tokens') }}</a>
                        <a href="/settings/account"><svg class="ti ti-settings"><use href="#ti-settings"/></svg> {{ t('ui.nav.settings') }}</a>
                        <a href="/notifications"><svg class="ti ti-bell"><use href="#ti-bell"/></svg> {{ t('ui.nav.notifications') }}</a>
                    {% endif %}
                    <div style="height: 1px; background: var(--gh-border-default, #30363d); margin: 6px 8px;"></div>
                    <a class="gh-user-danger" href="/logout" style="color:var(--gh-danger-fg, #f85149); font-weight:600;"><svg class="ti ti-logout"><use href="#ti-logout"/></svg> {{ t('ui.nav.sign_out') }}</a>
                {% else %}
                    <div style="height: 1px; background: var(--gh-border-default, #30363d); margin: 6px 8px;"></div>
                    <a href="/login"><svg class="ti ti-login"><use href="#ti-login"/></svg> {{ t('ui.nav.sign_in') }}</a>
                    <a href="/register"><svg class="ti ti-sparkles"><use href="#ti-sparkles"/></svg> {{ t('ui.nav.sign_up') }}</a>
                {% endif %}
                <div style="height: 1px; background: var(--gh-border-default, #30363d); margin: 6px 8px;"></div>
                <a href="/privacy"><svg class="ti ti-shield"><use href="#ti-shield"/></svg> Privacy</a>
                <a href="/terms"><svg class="ti ti-file-text"><use href="#ti-file-text"/></svg> Terms</a>
                <a href="/about"><svg class="ti ti-info-circle"><use href="#ti-info-circle"/></svg> About &amp; Rights</a>
                <a href="/security"><svg class="ti ti-lock"><use href="#ti-lock"/></svg> Security</a>
                <a href="/contact"><svg class="ti ti-mail"><use href="#ti-mail"/></svg> Contact</a>
                <a href="/support"><svg class="ti ti-lifebuoy"><use href="#ti-lifebuoy"/></svg> Support &amp; Tickets</a>
            </div>
        </div>
    </nav>

    <main class="gh-main">
        {# Global Notification / Flash Banner Container (Only renders when message is present) #}
        {% if not (hide_global_flash|default(false)) and ((error is defined and error) or (success is defined and success)) %}
        <div class="gh-notifications-wrapper" style="max-width: 1280px; margin: 0 auto; padding: 12px 16px 0; box-sizing: border-box; width: 100%;">
            {% if error is defined and error %}
                <div class="gh-alert-toast gh-alert-error" role="alert" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-radius: 6px; background: rgba(248, 81, 73, 0.12); border: 1px solid rgba(248, 81, 73, 0.35); color: var(--gh-danger-fg, #f85149); font-size: 13.5px; margin-bottom: 10px;">
                    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                        <span style="display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: rgba(248, 81, 73, 0.2); flex-shrink: 0;">
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M2.343 13.657A8 8 0 1 1 13.658 2.343 8 8 0 0 1 2.343 13.657ZM6.03 4.97a.751.751 0 0 0-1.06 1.06L6.94 8 4.97 9.97a.749.749 0 0 0 .326 1.275.749.749 0 0 0 .734-.215L8 9.06l1.97 1.97a.749.749 0 0 0 1.275-.326.749.749 0 0 0-.215-.734L9.06 8l1.97-1.97a.749.749 0 0 0-.326-1.275.749.749 0 0 0-.734.215L8 6.94 6.03 4.97Z"/></svg>
                        </span>
                        <span style="font-weight: 500; line-height: 1.4; color: var(--gh-fg-default, #1f2328);">{{ error }}</span>
                    </div>
                    <button type="button" onclick="this.closest('.gh-alert-toast').style.opacity='0'; setTimeout(() => this.closest('.gh-alert-toast').remove(), 250);" aria-label="Dismiss notification" style="background: transparent; border: none; color: var(--gh-fg-muted, #8b949e); cursor: pointer; padding: 2px 6px; font-size: 14px; line-height: 1; border-radius: 4px;">✕</button>
                </div>
            {% endif %}
            {% if success is defined and success %}
                <div class="gh-alert-toast gh-alert-success" role="status" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-radius: 6px; background: rgba(46, 160, 67, 0.12); border: 1px solid rgba(46, 160, 67, 0.35); color: var(--gh-success-fg, #2ea043); font-size: 13.5px; margin-bottom: 10px;">
                    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                        <span style="display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: rgba(46, 160, 67, 0.2); flex-shrink: 0;">
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
                        </span>
                        <span style="font-weight: 500; line-height: 1.4; color: var(--gh-fg-default, #1f2328);">{{ success }}</span>
                    </div>
                    <button type="button" onclick="this.closest('.gh-alert-toast').style.opacity='0'; setTimeout(() => this.closest('.gh-alert-toast').remove(), 250);" aria-label="Dismiss notification" style="background: transparent; border: none; color: var(--gh-fg-muted, #8b949e); cursor: pointer; padding: 2px 6px; font-size: 14px; line-height: 1; border-radius: 4px;">✕</button>
                </div>
            {% endif %}
        </div>
        {% endif %}

        {# Floating Dynamic Toast Container #}
        <div id="gh-toast-stack" style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; max-width: calc(100vw - 48px); pointer-events: none;"></div>

        {% block content %}{% endblock %}
    </main>

    <footer class="gh-footer">
        <div class="gh-footer-inner">
            <div class="gh-footer-left">
                <a class="gh-footer-logo" href="/" aria-label="{{ app_name }}">
                    {% include "partials/logo.twig" with { size: 20, radius: 5 } %}
                </a>
                <span>&copy; {{ "now"|date("Y") }} {% include "partials/brand-name.twig" %}, Inc.</span>
            </div>
            <nav class="gh-footer-links" aria-label="Footer navigation">
                <a href="/terms">{{ t('ui.footer.terms') }}</a>
                <a href="/privacy">{{ t('ui.footer.privacy') }}</a>
                <a href="/security">{{ t('ui.footer.security') }}</a>
                <a href="/docs">{{ t('ui.footer.docs') }}</a>
                <a href="/contact">{{ t('ui.footer.contact') }}</a>
            </nav>
            <div class="gh-footer-right">
                <span class="gh-footer-made-in">{{ t('ui.footer.made_with_love')|raw }}</span>
            </div>
        </div>
    </footer>

    {# Shared behaviors (copy, select-on-click, confirms, refs, highlight.js) #}
    <script src="{{ asset('assets/js/main.js') }}" defer></script>
    {# GitHub-theme behaviors (theme toggle, drawer, card search filter) #}
    <script src="{{ asset('assets/js/github.js') }}" defer></script>
    {% block scripts %}{% endblock %}

    {# ── Floating Maintenance & Cache Action Button (FAB) — owner only ── #}
    {% if is_owner|default(false) %}
    <div id="gh-fab-maintenance" style="position: fixed; bottom: 18px; left: 16px; z-index: 999999; font-family: var(--gh-font-sans, system-ui, sans-serif);">
        <button type="button" id="gh-fab-btn" onclick="toggleFabDrawer(event)" ontouchstart="toggleFabDrawer(event)"
                style="display: inline-flex; align-items: center; gap: 8px; background: #238636; color: #ffffff; border: 1px solid rgba(240,246,252,0.25); border-radius: 30px; padding: 10px 16px; font-size: 13px; font-weight: 600; cursor: pointer; box-shadow: 0 8px 24px rgba(0,0,0,0.6); -webkit-tap-highlight-color: transparent;">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M14.7 1.3a1 1 0 0 0-1.4 0l-3.3 3.3a5.5 5.5 0 1 0 1.4 1.4l3.3-3.3a1 1 0 0 0 0-1.4zM7 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
            <span>Maintenance &amp; Cache</span>
        </button>

        {# Floating Modal Drawer #}
        <div id="gh-fab-drawer" style="display: none; position: fixed; bottom: 70px; left: 16px; width: 310px; max-width: calc(100vw - 32px); background: var(--gh-bg-overlay, #161b22); border: 1px solid var(--gh-border-default, #30363d); border-radius: 12px; box-shadow: 0 16px 36px rgba(0,0,0,0.7); padding: 14px; box-sizing: border-box; z-index: 999999;">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--gh-border-default, #30363d); padding-bottom: 8px; margin-bottom: 12px;">
                <span style="font-weight: 600; font-size: 13.5px; color: var(--gh-fg-default, #e6edf3); display: flex; align-items: center; gap: 6px;">
                    Cache &amp; Maintenance
                </span>
                <button type="button" onclick="closeFabDrawer()" style="background: transparent; border: none; color: var(--gh-fg-muted, #8b949e); cursor: pointer; font-size: 18px; padding: 4px;">✕</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button type="button" onclick="purgeSystemCache('local')" class="gh-btn" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: right; padding: 8px 10px; font-size: 12.5px; cursor: pointer;">
                    <span>Local file cache</span>
                    <small style="color: var(--gh-fg-muted);">.cache</small>
                </button>
                <button type="button" onclick="purgeSystemCache('twig')" class="gh-btn" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: right; padding: 8px 10px; font-size: 12.5px; cursor: pointer;">
                    <span>Twig templates cache</span>
                    <small style="color: var(--gh-fg-muted);">storage/twig</small>
                </button>
                <button type="button" onclick="purgeSystemCache('opcache')" class="gh-btn" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: right; padding: 8px 10px; font-size: 12.5px; cursor: pointer;">
                    <span>OPCache</span>
                    <small style="color: var(--gh-fg-muted);">PHP memory</small>
                </button>
                <button type="button" onclick="purgeSystemCache('redis')" class="gh-btn" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: right; padding: 8px 10px; font-size: 12.5px; cursor: pointer;">
                    <span>Redis cache</span>
                    <small style="color: var(--gh-fg-muted);">FLUSHDB</small>
                </button>
                <button type="button" onclick="purgeSystemCache('memcached')" class="gh-btn" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: right; padding: 8px 10px; font-size: 12.5px; cursor: pointer;">
                    <span>Memcached</span>
                    <small style="color: var(--gh-fg-muted);">flush_all</small>
                </button>
                <button type="button" onclick="purgeSystemCache('all')" class="gh-btn gh-btn-primary" style="display: flex; align-items: center; justify-content: center; width: 100%; padding: 9px; font-size: 13px; font-weight: 600; margin-top: 4px; background: #da3633 !important; border-color: rgba(240,246,252,0.1) !important; cursor: pointer;">
                    <span>Clear all caches</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        let fabLastTouch = 0;
        function toggleFabDrawer(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const now = Date.now();
            if (now - fabLastTouch < 250) return;
            fabLastTouch = now;

            const d = document.getElementById('gh-fab-drawer');
            if (!d) return;
            d.style.display = (d.style.display === 'block') ? 'none' : 'block';
        }

        function closeFabDrawer() {
            const d = document.getElementById('gh-fab-drawer');
            if (d) d.style.display = 'none';
        }

        document.addEventListener('click', function(e) {
            const fab = document.getElementById('gh-fab-maintenance');
            if (fab && !fab.contains(e.target)) {
                closeFabDrawer();
            }
        });

        function purgeSystemCache(type) {
            var ctrl = new AbortController();
            var timer = setTimeout(function(){ ctrl.abort(); }, 8000);
            fetch('/api/v1/maintenance/clear-cache', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRF-Token': '{{ session_csrf_token }}'
                },
                body: 'type=' + encodeURIComponent(type),
                signal: ctrl.signal
            })
            .then(res => res.json())
            .then(data => {
                clearTimeout(timer);
                if (data.success) {
                    alert('Cache purge completed: ' + data.message);
                    window.location.reload(true);
                } else {
                    alert('Cache purge failed: ' + (data.message || 'unknown error'));
                }
            })
            .catch(err => {
                clearTimeout(timer);
                if (err && err.name === 'AbortError') {
                    alert('Request timed out — the server may be slow. Try again.');
                } else {
                    alert('An error occurred while contacting the server.');
                }
            });
        }
    </script>
    {% endif %}


    {# ── GitHub Command Palette Modal (Ctrl+K / ⌘K) ── #}
    <div id="gh-command-palette" class="gh-cmd-palette" aria-modal="true" role="dialog" hidden>
        <div class="gh-cmd-palette-backdrop" data-cmd-close></div>
        <div class="gh-cmd-palette-dialog">
            <div class="gh-cmd-palette-search">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="color: var(--gh-fg-muted); flex-shrink: 0;"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
                <input type="text" id="gh-cmd-input" placeholder="Type a command or search (e.g. repo, settings, theme)..." autocomplete="off" spellcheck="false">
                <kbd class="gh-cmd-kbd" data-cmd-close>ESC</kbd>
            </div>
            <div class="gh-cmd-palette-body" id="gh-cmd-results">
                <!-- Dynamically populated commands & shortcuts -->
            </div>
            <div class="gh-cmd-palette-footer">
                <span><kbd>↑</kbd> <kbd>↓</kbd> Navigate</span>
                <span><kbd>↵</kbd> Select</span>
                <span><kbd>ESC</kbd> Close</span>
            </div>
        </div>
    </div>

</body>
</html>
