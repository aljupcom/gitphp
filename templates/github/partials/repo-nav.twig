        {% set pr_open = pulls_open_count|default(0) %}
        {% if pr_open > 0 %}
            <span class="gh-tab-count">{{ pr_open }}</span>
        {% endif %}
    </a>

    <a class="gh-tab{{ active_tab == 'commits' ? ' active' }}" href="/{{ nav_owner }}/{{ repo.slug }}/commits">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.751.751 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0Z"/></svg>
