{# Unified repository sub-navigation (Code, Issues, Pulls, Commits, Branches, Tags, Releases, Wiki, Insights, Settings) #}
{% set __nav_h = repo_header(repo, current_ref|default('')) %}
{% set nav_owner = owner|default(__nav_h.owner|default(repo.owner|default('admin'))) %}
<nav class="gh-repo-nav" aria-label="Repository navigation">
    <a class="gh-tab{{ active_tab == 'code' ? ' active' }}" href="/{{ nav_owner }}/{{ repo.slug }}">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"/></svg>
        <span>{{ t('ui.repo.code') }}</span>
    </a>

    <a class="gh-tab{{ active_tab == 'issues' ? ' active' }}" href="/{{ nav_owner }}/{{ repo.slug }}/issues">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z"/></svg>
