        {% if r_count > 0 %}
            <span class="gh-tab-count">{{ r_count }}</span>
        {% endif %}
    </a>

    <a class="gh-tab{{ active_tab == 'wiki' ? ' active' }}" href="/{{ nav_owner }}/{{ repo.slug }}/wiki">
