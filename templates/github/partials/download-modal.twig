{# Reusable GitHub-Authentic Secure Download & Share Modal #}
<div id="gh-download-modal" class="gh-modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(27, 31, 36, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
    <div class="gh-modal-dialog" style="background: var(--gh-bg-canvas); border: 1px solid var(--gh-border-default); border-radius: 12px; width: 100%; max-width: 520px; box-shadow: 0 12px 32px rgba(0,0,0,0.2); overflow: hidden; animation: ghModalPop 0.18s cubic-bezier(0.16, 1, 0.3, 1);">
        
        <!-- Modal Header -->
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--gh-border-default); background: var(--gh-bg-subtle);">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" style="color: var(--gh-accent-fg);"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
                <strong id="dl-modal-title" style="font-size: 14px; color: var(--gh-fg-default);">Secure Download & Share</strong>
            </div>
            <button type="button" class="gh-icon-btn" onclick="closeDownloadModal()" aria-label="Close dialog" style="width: 28px; height: 28px; border-radius: 6px;">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"/></svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div style="padding: 20px;">
            <!-- Target Item Info Badge -->
            <div style="background: var(--gh-bg-subtle); border: 1px solid var(--gh-border-muted); border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <span style="font-size: 11px; color: var(--gh-fg-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block;">Target Payload</span>
                    <strong id="dl-modal-target-name" style="font-size: 13px; color: var(--gh-fg-default); word-break: break-all;">Archive Payload</strong>
                </div>
                <span id="dl-modal-type-badge" class="gh-badge">ZIP</span>
            </div>

            <!-- Generate Short Link Options Form -->
            <div id="dl-modal-options">
                <div class="gh-form-group">
                    <label class="gh-form-label" for="dl-opt-password">Password Protection (Optional)</label>
                    <input type="password" id="dl-opt-password" placeholder="Leave empty for public access" class="gh-form-control">
                    <div class="gh-form-hint">Encrypt with password before granting download access.</div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="gh-form-group">
                        <label class="gh-form-label" for="dl-opt-expiry">Expires After (Days)</label>
                        <input type="number" id="dl-opt-expiry" min="1" max="365" placeholder="e.g. 7" class="gh-form-control">
                    </div>
                    <div class="gh-form-group">
                        <label class="gh-form-label" for="dl-opt-limit">Max Downloads</label>
                        <input type="number" id="dl-opt-limit" min="1" placeholder="Unlimited" class="gh-form-control">
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--gh-border-muted);">
                    <button type="button" id="dl-direct-btn" class="gh-btn" onclick="triggerDirectDownload()">
                        Direct Download
                    </button>
                    <button type="button" id="dl-generate-btn" class="gh-btn gh-btn-primary" onclick="generateShortLink()">
                        Generate Short Link
                    </button>
                </div>
            </div>

            <!-- Result Box with Copy Link -->
            <div id="dl-modal-result" style="display: none; margin-top: 12px;">
                <div style="background: #dafbe1; border: 1px solid #4ac26b; border-radius: 8px; padding: 14px; margin-bottom: 14px;">
                    <strong style="color: #1a7f37; font-size: 13px; display: block; margin-bottom: 6px;">
                        ✓ Secure Short Link Generated!
                    </strong>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" id="dl-result-url" readonly class="gh-form-control" style="font-family: monospace; font-size: 12px; background: #ffffff; color: #1f2328;">
                        <button type="button" id="dl-copy-btn" class="gh-btn gh-btn-primary" onclick="copyShortUrl()" style="white-space: nowrap;">
                            Copy Link
                        </button>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a id="dl-open-link" href="#" target="_blank" class="gh-btn gh-btn-sm">
                        Open Download Gateway ↗
                    </a>
                    <button type="button" class="gh-btn gh-btn-sm" onclick="resetDownloadModal()">
                        Create Another
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
@keyframes ghModalPop {
    from { opacity: 0; transform: scale(0.96) translateY(-8px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}
</style>

<script>
let currentDlPayload = {
    type: 'repo_archive',
    slug: '',
    ref: 'HEAD',
    path: '',
    title: '',
    directUrl: ''
};

function openDownloadModal(type, slug, ref, path, title, directUrl) {
    currentDlPayload = { type, slug, ref, path, title, directUrl };
    
    document.getElementById('dl-modal-title').innerText = title || 'Download & Share';
    document.getElementById('dl-modal-target-name').innerText = (path || slug) + (ref ? ' (' + ref + ')' : '');
    document.getElementById('dl-modal-type-badge').innerText = type === 'blob' ? 'FILE' : 'ZIP';
    
    document.getElementById('dl-opt-password').value = '';
    document.getElementById('dl-opt-expiry').value = '';
    document.getElementById('dl-opt-limit').value = '';
    
    document.getElementById('dl-modal-options').style.display = 'block';
    document.getElementById('dl-modal-result').style.display = 'none';
    
    const modal = document.getElementById('gh-download-modal');
    modal.style.display = 'flex';
}

function closeDownloadModal() {
    document.getElementById('gh-download-modal').style.display = 'none';
}

function resetDownloadModal() {
    document.getElementById('dl-modal-options').style.display = 'block';
    document.getElementById('dl-modal-result').style.display = 'none';
}

function triggerDirectDownload() {
    if (currentDlPayload.directUrl) {
        window.location.href = currentDlPayload.directUrl;
        closeDownloadModal();
    }
}

async function generateShortLink() {
    const btn = document.getElementById('dl-generate-btn');
    btn.disabled = true;
    btn.innerText = 'Generating...';

    const csrfToken = '{{ csrf_token }}' || (document.querySelector('input[name="csrf_token"]') ? document.querySelector('input[name="csrf_token"]').value : '');

    const formData = new FormData();
    formData.append('csrf_token', csrfToken);
    formData.append('type', currentDlPayload.type);
    formData.append('slug', currentDlPayload.slug);
    formData.append('ref', currentDlPayload.ref);
    formData.append('path', currentDlPayload.path);
    formData.append('password', document.getElementById('dl-opt-password').value);
    formData.append('expiry_days', document.getElementById('dl-opt-expiry').value);
    formData.append('max_downloads', document.getElementById('dl-opt-limit').value);

    try {
        const response = await fetch('/api/downloads/generate', {
            method: 'POST',
            body: formData
        });
        const json = await response.json();
        btn.disabled = false;
        btn.innerText = 'Generate Short Link';

        if (json.ok && json.data) {
            document.getElementById('dl-result-url').value = json.data.short_url;
            document.getElementById('dl-open-link').href = json.data.short_url;
            document.getElementById('dl-modal-options').style.display = 'none';
            document.getElementById('dl-modal-result').style.display = 'block';
        } else {
            alert('Error generating link: ' + (json.error || 'Unknown error'));
        }
    } catch (e) {
        btn.disabled = false;
        btn.innerText = 'Generate Short Link';
        alert('Network error while generating short link.');
    }
}

function copyShortUrl() {
    const input = document.getElementById('dl-result-url');
    input.select();
    navigator.clipboard.writeText(input.value);
    const btn = document.getElementById('dl-copy-btn');
    btn.innerText = 'Copied!';
    setTimeout(() => { btn.innerText = 'Copy Link'; }, 2000);
}
</script>
