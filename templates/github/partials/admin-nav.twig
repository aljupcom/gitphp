{# GitHub Enterprise Site Admin Navigation #}
{% set counts = counts|default({}) %}
{% set ap = admin_prefix|default('/admin') %}

{# ── MOBILE SELECT NAVIGATION (Shown on <= 768px) ── #}
<div class="gh-nav-mobile-wrapper" style="margin-bottom: 16px; width: 100%;">
    <label for="gh-admin-nav-select" style="display: block; font-size: 12px; font-weight: 600; color: var(--gh-fg-muted); margin-bottom: 6px;">Site Admin Navigation</label>
    <div style="position: relative; width: 100%;">
        <select id="gh-admin-nav-select" class="gh-select gh-nav-select" onchange="if(this.value) window.location.href=this.value;" style="width: 100%; height: 38px; padding: 0 32px 0 12px; font-size: 13.5px; font-weight: 500; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-subtle); color: var(--gh-fg-default); appearance: none; -webkit-appearance: none; cursor: pointer; box-sizing: border-box;">
            <optgroup label="{{ t('adm.nav_sections.management')|default('Site Admin') }}">
                <option value="{{ ap }}" {{ active == 'overview' ? 'selected' : '' }}>📊 {{ t('adm.nav.overview')|default('Overview') }}</option>
                <option value="{{ ap }}/system" {{ active == 'system' ? 'selected' : '' }}>⚡ {{ t('adm.nav.system')|default('System Status') }}</option>
                <option value="{{ ap }}/audit-logs" {{ active == 'audit' ? 'selected' : '' }}>📜 {{ t('adm.nav.audit_log')|default('Audit Log') }}</option>
            </optgroup>
            <optgroup label="{{ t('adm.nav_sections.security')|default('User & Access Management') }}">
                <option value="{{ ap }}/users" {{ active == 'users' ? 'selected' : '' }}>👥 {{ t('adm.nav.users')|default('All Users & Members') }}</option>
                <option value="{{ ap }}/sessions" {{ active == 'sessions' ? 'selected' : '' }}>📱 {{ t('adm.nav.sessions')|default('Active Sessions') }}</option>
                <option value="{{ ap }}/ssh-keys" {{ active == 'ssh' ? 'selected' : '' }}>🔑 {{ t('adm.nav.ssh_keys')|default('Deploy & SSH Keys') }}</option>
                <option value="{{ ap }}/tokens" {{ active == 'tokens' ? 'selected' : '' }}>🎫 {{ t('adm.nav.tokens')|default('Personal Access Tokens') }}</option>
            </optgroup>
            <optgroup label="{{ t('adm.nav_sections.repositories')|default('Repositories & Code') }}">
                <option value="{{ ap }}/repos" {{ active == 'repos' ? 'selected' : '' }}>📦 {{ t('adm.nav.repositories')|default('All Repositories') }}</option>
                <option value="{{ ap }}/repos/create" {{ active == 'create_repo' ? 'selected' : '' }}>+ {{ t('adm.nav.create_repo')|default('New Repository') }}</option>
                <option value="{{ ap }}/repos/import" {{ active == 'import' ? 'selected' : '' }}>⤓ {{ t('adm.nav.import_repo')|default('Import Repository') }}</option>
            </optgroup>
            <optgroup label="{{ t('adm.nav_sections.services')|default('Services & Distribution') }}">
                <option value="{{ ap }}/bug-reports" {{ active == 'issues' ? 'selected' : '' }}>🐛 Bug Reports</option>
                <option value="{{ ap }}/downloads" {{ active == 'downloads' ? 'selected' : '' }}>☁ Download Center</option>
                <option value="{{ ap }}/downloads/reports" {{ active == 'download_reports' ? 'selected' : '' }}>🚩 {{ t('adm.nav.download_reports')|default('Broken Link Reports') }}</option>
                <option value="{{ ap }}/devices" {{ active == 'devices' ? 'selected' : '' }}>📱 Device Database (53.4k)</option>
                <option value="{{ ap }}/webhooks" {{ active == 'webhooks' ? 'selected' : '' }}>🔗 Webhooks &amp; Integrations</option>
            </optgroup>
            <optgroup label="{{ t('adm.nav_sections.governance')|default('Policies & Quotas') }}">
                <option value="{{ ap }}/limits" {{ active == 'limits' ? 'selected' : '' }}>⚖️ Global Limits &amp; Quotas</option>
                <option value="{{ ap }}/licenses" {{ active == 'licenses' ? 'selected' : '' }}>🛡️ IP License Manager</option>
            </optgroup>
            <optgroup label="{{ t('adm.nav_sections.system')|default('System Settings') }}">
                <option value="{{ ap }}/settings" {{ active == 'settings' ? 'selected' : '' }}>⚙ Platform Settings</option>
                <option value="{{ ap }}/email" {{ active == 'email' ? 'selected' : '' }}>✉ Email &amp; Notifications</option>
            </optgroup>
        </select>
        <svg style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; width: 14px; height: 14px; fill: var(--gh-fg-muted);" viewBox="0 0 16 16"><path d="m4.427 6.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 6H4.604a.25.25 0 0 0-.177.427Z"/></svg>
    </div>
</div>

{# ── DESKTOP SIDEBAR NAVIGATION (Shown on > 768px) ── #}
<nav class="gh-admin-nav gh-nav-desktop" aria-label="Site Administration">
    {# 1. Site Administration / Overview #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.management')|default('Site Admin') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}" class="{{ active == 'overview' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-dashboard" style="font-size:16px;"><use href="#ti-dashboard"/></svg>
                    <span>{{ t('adm.nav.overview') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/system" class="{{ active == 'system' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-cpu" style="font-size:16px;"><use href="#ti-cpu"/></svg>
                    <span>{{ t('adm.nav.system')|default('System Status') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/audit-logs" class="{{ active == 'audit' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-history" style="font-size:16px;"><use href="#ti-history"/></svg>
                    <span>{{ t('adm.nav.audit_log') }}</span>
                </div>
            </a>
        </div>
    </div>

    {# 2. User & Access Management #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.security')|default('User & Access Management') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}/users" class="{{ active == 'users' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-users" style="font-size:16px;"><use href="#ti-users"/></svg>
                    <span>{{ t('adm.nav.users')|default('All Users & Members') }}</span>
                </div>
                {% if counts.users is defined %}<span class="gh-badge" style="font-size:11px;">{{ counts.users }}</span>{% endif %}
            </a>
            <a href="{{ ap }}/sessions" class="{{ active == 'sessions' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-device-laptop" style="font-size:16px;"><use href="#ti-device-laptop"/></svg>
                    <span>{{ t('adm.nav.sessions') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/ssh-keys" class="{{ active == 'ssh' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-key" style="font-size:16px;"><use href="#ti-key"/></svg>
                    <span>{{ t('adm.nav.ssh_keys')|default('Deploy & SSH Keys') }}</span>
                </div>
                {% if counts.ssh_keys is defined %}<span class="gh-badge" style="font-size:11px;">{{ counts.ssh_keys }}</span>{% endif %}
            </a>
            <a href="{{ ap }}/tokens" class="{{ active == 'tokens' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-ticket" style="font-size:16px;"><use href="#ti-ticket"/></svg>
                    <span>{{ t('adm.nav.tokens')|default('Access Tokens') }}</span>
                </div>
            </a>
        </div>
    </div>

    {# 3. Code & Repositories #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.repositories')|default('Repositories & Code') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}/repos" class="{{ active == 'repos' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-box" style="font-size:16px;"><use href="#ti-box"/></svg>
                    <span>{{ t('adm.nav.repositories') }}</span>
                </div>
                {% if counts.repos is defined %}<span class="gh-badge" style="font-size:11px;">{{ counts.repos }}</span>{% endif %}
            </a>
            <a href="{{ ap }}/repos/create" class="{{ active == 'create_repo' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-plus" style="font-size:16px;"><use href="#ti-plus"/></svg>
                    <span>{{ t('adm.nav.create_repo') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/repos/import" class="{{ active == 'import' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-download" style="font-size:16px;"><use href="#ti-download"/></svg>
                    <span>{{ t('adm.nav.import_repo') }}</span>
                </div>
            </a>
        </div>
    </div>

    {# 4. Platform Services #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.services')|default('Services & Distribution') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}/bug-reports" class="{{ active == 'issues' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-bug" style="font-size:16px;"><use href="#ti-bug"/></svg>
                    <span>{{ t('adm.nav.bug_reports') }}</span>
                </div>
                {% if counts.issues is defined and counts.issues > 0 %}
                    <span class="gh-badge" style="background:rgba(248,81,73,0.15); color:#f85149; font-size:11px;">{{ counts.issues }}</span>
                {% endif %}
            </a>
            <a href="{{ ap }}/downloads" class="{{ active == 'downloads' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-cloud-download" style="font-size:16px;"><use href="#ti-cloud-download"/></svg>
                    <span>{{ t('adm.nav.downloads') }}</span>
                </div>
                {% if counts.downloads is defined %}<span class="gh-badge" style="font-size:11px;">{{ counts.downloads }}</span>{% endif %}
            </a>
            <a href="{{ ap }}/downloads/reports" class="{{ active == 'download_reports' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-flag" style="font-size:16px; color:#cf222e;"><use href="#ti-flag"/></svg>
                    <span>{{ t('adm.nav.download_reports')|default('Broken Links') }}</span>
                </div>
                {% if counts.download_reports is defined and counts.download_reports > 0 %}
                    <span class="gh-badge" style="background:rgba(207,34,46,0.15); color:#cf222e; font-size:11px; font-weight:700;">{{ counts.download_reports }}</span>
                {% endif %}
            </a>
            <a href="{{ ap }}/devices" class="{{ active == 'devices' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-device-mobile" style="font-size:16px;"><use href="#ti-device-mobile"/></svg>
                    <span>{{ t('adm.nav.devices') }}</span>
                </div>
                <span class="gh-badge" style="font-size:11px;">53.4k</span>
            </a>
            <a href="{{ ap }}/webhooks" class="{{ active == 'webhooks' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-webhook" style="font-size:16px;"><use href="#ti-webhook"/></svg>
                    <span>{{ t('adm.nav.webhooks') }}</span>
                </div>
            </a>
        </div>
    </div>

    {% if is_admin %}
    {# 5. Governance & Policies #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.governance')|default('Policies & Quotas') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}/limits" class="{{ active == 'limits' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-adjustments" style="font-size:16px;"><use href="#ti-adjustments"/></svg>
                    <span>{{ t('adm.nav.limits') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/licenses" class="{{ active == 'licenses' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-shield-check" style="font-size:16px;"><use href="#ti-shield-check"/></svg>
                    <span>{{ t('adm.nav.licenses') }}</span>
                </div>
                {% if counts.licenses is defined %}<span class="gh-badge" style="font-size:11px;">{{ counts.licenses }}</span>{% endif %}
            </a>
        </div>
    </div>

    {# 6. System Configuration #}
    <div>
        <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--gh-fg-muted); letter-spacing:0.5px; padding:4px 10px; margin-bottom:4px;">
            {{ t('adm.nav_sections.system')|default('System Settings') }}
        </div>
        <div style="display:flex; flex-direction:column; gap:2px;">
            <a href="{{ ap }}/settings" class="{{ active == 'settings' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-settings" style="font-size:16px;"><use href="#ti-settings"/></svg>
                    <span>{{ t('adm.nav.settings') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/email" class="{{ active == 'email' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-mail" style="font-size:16px;"><use href="#ti-mail"/></svg>
                    <span>{{ t('adm.nav.email') }}</span>
                </div>
            </a>
            <a href="{{ ap }}/languages" class="{{ active == 'languages' ? 'is-active' : '' }}" style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; border-radius:6px; font-size:13.5px; text-decoration:none;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-world" style="font-size:16px;"><use href="#ti-world"/></svg>
                    <span>{{ t('adm.nav.languages') }}</span>
                </div>
            </a>
        </div>
    </div>
    {% endif %}
</nav>
