{# Unified repository header matching GitHub exact standard:
   Renders Breadcrumb + Visibility Badge (left) and Star / Watch / Fork actions (right).
   On small screens, the actions row wraps to a second line — exactly like GitHub.com. #}
{% set __h = repo_header(repo, current_ref|default('')) %}

{% if __h is empty %}
<div class="gh-repo-header" style="margin-bottom: 12px;">
    <div class="gh-repo-breadcrumb" style="display: flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 600; flex-wrap: wrap;">
        <span class="gh-owner" style="color: var(--gh-fg-muted, #8b949e);">{{ owner|default('') }}</span><span class="gh-slash" style="color: var(--gh-fg-subtle, #6e7681);">/</span>
        <a class="gh-name" href="/{{ owner|default('') }}/{{ repo.slug|default('') }}" style="color: var(--gh-accent-fg, #58a6ff); font-weight: 600; text-decoration: none;">{{ repo.name|default(repo.slug|default('')) }}</a>
    </div>
</div>
{% else %}
<div class="gh-repo-header gh-repo-header-root" style="margin-bottom: 12px;">

    {# Row 1: Breadcrumb (left) + Social Actions (right) #}
    <div class="gh-repo-header-top" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">

        {# Left: Repo Icon + Breadcrumb + Badge #}
        <div class="gh-repo-breadcrumb-wrap" style="display: flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 600; flex-wrap: wrap; line-height: 1.35; min-width: 0; flex: 0 1 auto; direction: ltr;">
            <svg class="gh-repo-header-icon" width="16" height="16" viewBox="0 0 16 16" fill="var(--gh-fg-muted, #8b949e)" aria-hidden="true" style="flex-shrink: 0;"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
            <a class="gh-owner" href="/{{ __h.owner }}" style="color: var(--gh-fg-muted, #8b949e); font-weight: 400; text-decoration: none;">{{ __h.owner }}</a>
            <span class="gh-slash" style="color: var(--gh-fg-subtle, #6e7681); font-weight: 400;">/</span>
            <a class="gh-name" href="/{{ __h.owner }}/{{ __h.repo.slug }}" style="color: var(--gh-accent-fg, #58a6ff); font-weight: 600; text-decoration: none; word-break: break-word;">{{ __h.repo.name }}</a>
            <span class="gh-badge{{ __h.repo.visibility == 'private' ? ' gh-badge-private' : '' }}" style="font-size: 11px; font-weight: 500; padding: 1px 7px; border-radius: 10px; border: 1px solid var(--gh-border-default, #30363d); color: var(--gh-fg-muted, #8b949e); text-transform: capitalize; white-space: nowrap; flex-shrink: 0;">
                {% if __h.repo.visibility == 'private' %}
                    <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true" style="vertical-align: -1px; margin-right: 2px;"><path d="M4 4a4 4 0 0 1 8 0v2h.25c.966 0 1.75.784 1.75 1.75v5.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25v-5.5C2 6.784 2.784 6 3.75 6H4Zm8.25 3.5h-8.5a.25.25 0 0 0-.25.25v5.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-5.5a.25.25 0 0 0-.25-.25ZM10.5 6V4a2.5 2.5 0 1 0-5 0v2Z"/></svg>
                {% endif %}
                {{ __h.repo.visibility }}
            </span>
        </div>

        {# Right: Social Action Buttons — RSS / Star / Watch / Fork #}
        <div class="gh-repo-actions" style="display: flex; align-items: center; gap: 6px; flex-shrink: 0; flex-wrap: wrap;">

            {# RSS Feed #}
            <a class="gh-btn gh-btn-sm gh-social-btn" href="/{{ __h.owner }}/{{ __h.repo.slug }}.rss" target="_blank"
               title="RSS Feed of recent commits"
               style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; white-space: nowrap;">
                <svg class="ti ti-rss" style="font-size: 13px; color: #f0883e;"><use href="#ti-rss"/></svg>
                <span>RSS</span>
            </a>

            {% if __h.social and __h.social.can_interact %}

                {# Star #}
                <form method="POST" action="/{{ __h.owner }}/{{ __h.repo.slug }}/star" class="gh-inline-form" style="display: contents;">
                    <input type="hidden" name="csrf_token" value="{{ __h.csrf }}">
                    <button type="submit"
                            class="gh-btn gh-btn-sm gh-social-btn{{ __h.social.is_starred ? ' active' : '' }}"
                            title="{{ __h.social.is_starred ? 'Unstar' : 'Star' }} this repository"
                            style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; cursor: pointer;">
                        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                        <span>{{ __h.social.is_starred ? t('ui.repo.starred')|default('Starred') : t('ui.repo.star') }}</span>
                        <span class="gh-tab-count" style="background: var(--gh-bg-subtle, rgba(255,255,255,0.08)); padding: 0 5px; border-radius: 9px; font-size: 10.5px;">{{ __h.social.stars }}</span>
                    </button>
                </form>

                {# Watch #}
                <form method="POST" action="/{{ __h.owner }}/{{ __h.repo.slug }}/watch" class="gh-inline-form" style="display: contents;">
                    <input type="hidden" name="csrf_token" value="{{ __h.csrf }}">
                    <button type="submit"
                            class="gh-btn gh-btn-sm gh-social-btn{{ __h.social.is_watching ? ' active' : '' }}"
                            title="{{ __h.social.is_watching ? 'Stop watching' : 'Watch' }} this repository"
                            style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; cursor: pointer;">
                        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z"/></svg>
                        <span>{{ __h.social.is_watching ? t('ui.repo.watching') : t('ui.repo.watch') }}</span>
                        <span class="gh-tab-count" style="background: var(--gh-bg-subtle, rgba(255,255,255,0.08)); padding: 0 5px; border-radius: 9px; font-size: 10.5px;">{{ __h.social.watchers }}</span>
                    </button>
                </form>

            {% else %}
                {# Non-interactive star counter #}
                {% if is_logged_in %}
                    <span class="gh-btn gh-btn-sm gh-social-btn gh-social-static"
                          title="Only registered user accounts can star repositories"
                          style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;">
                        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                        <span>{{ t('ui.repo.star') }}</span>
                        <span class="gh-tab-count" style="background: var(--gh-bg-subtle, rgba(255,255,255,0.08)); padding: 0 5px; border-radius: 9px; font-size: 10.5px;">{{ __h.social.stars|default(0) }}</span>
                    </span>
                {% else %}
                    <a class="gh-btn gh-btn-sm gh-social-btn" href="/login" title="Sign in to star this repository"
                       style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; white-space: nowrap;">
                        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                        <span>{{ t('ui.repo.star') }}</span>
                        <span class="gh-tab-count" style="background: var(--gh-bg-subtle, rgba(255,255,255,0.08)); padding: 0 5px; border-radius: 9px; font-size: 10.5px;">{{ __h.social.stars|default(0) }}</span>
                    </a>
                {% endif %}
            {% endif %}

            {# Fork #}
            {% if __h.can_fork %}
                <a class="gh-btn gh-btn-sm" href="/{{ __h.owner }}/{{ __h.repo.slug }}/fork" title="Fork this repository"
                   style="font-size: 12px; padding: 3px 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; white-space: nowrap;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878Zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm3-8.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/></svg>
                    <span>{{ t('ui.repo.fork') }}</span>
                    <span class="gh-tab-count" style="background: var(--gh-bg-subtle, rgba(255,255,255,0.08)); padding: 0 5px; border-radius: 9px; font-size: 10.5px;">{{ __h.forks_count|default(0) }}</span>
                </a>
            {% endif %}

        </div>{# /.gh-repo-actions #}
    </div>{# /.gh-repo-header-top #}

    {# Row 2: Imported-from or Forked-from notice #}
    {% if __h.repo.source_url %}
        <div style="font-size: 12px; color: var(--gh-fg-muted, #8b949e); margin-top: 4px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" style="opacity: 0.85; flex-shrink: 0;"><path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7 7 0 0 1 1.05 8.84a.75.75 0 0 1 .655-.835Zm11.89-1.01a.75.75 0 0 1-.834-.656 5.5 5.5 0 0 0-9.592-2.97l1.204 1.204a.25.25 0 0 1-.177.427H.55a.25.25 0 0 1-.25-.25V1.104a.25.25 0 0 1 .427-.177l1.38 1.38A7 7 0 0 1 14.95 7.16a.75.75 0 0 1-.655.835Z"/></svg>
            <span>{{ t('ui.repo.imported_from')|default('imported from') }} <a href="{{ __h.repo.source_url }}" target="_blank" rel="noopener noreferrer" style="color: var(--gh-accent-fg, #58a6ff); text-decoration: none; word-break: break-all;">{{ __h.repo.source_url }}</a></span>
            {% if __h.repo.last_synced_at %}
                <span style="color: var(--gh-fg-muted); opacity: 0.6;">·</span>
                <span>{{ t('ui.repo_settings.last_synced')|default(t('ui.last_synced'))|replace({'{time}': __h.repo.last_synced_at|time_ago}) }}</span>
            {% endif %}
        </div>
    {% elseif __h.repo.parent_slug %}
        <div style="font-size: 12px; color: var(--gh-fg-muted, #8b949e); margin-top: 4px;">
            {{ t('ui.repo.forked_from')|default('forked from') }} <a href="/{{ __h.owner }}/{{ __h.repo.parent_slug }}" style="color: var(--gh-accent-fg, #58a6ff); text-decoration: none;">{{ __h.owner }}/{{ __h.repo.parent_slug }}</a>
        </div>
    {% endif %}

    {# Row 3: Description #}
    {% if __h.repo.description %}
        <p class="gh-repo-desc" style="margin: 5px 0 0 0; color: var(--gh-fg-muted, #8b949e); font-size: 13px; line-height: 1.5; word-break: break-word;">{{ __h.repo.description }}</p>
    {% endif %}

</div>{# /.gh-repo-header-root #}
{% endif %}
