{% extends "layout.twig" %}

{% block title %}{{ t('ui.auth.reset_title') }} · {{ app_name }}{% endblock %}

{% block content %}
<section class="gh-auth">
    <div style="text-align: center; margin-bottom: 24px;">
        <a href="/" aria-label="{{ app_name }}" style="display: inline-block; text-decoration: none;">
            {% include "partials/logo.twig" with { size: 48 } %}
        </a>
    </div>

    <h1 class="gh-auth-title">{{ t('ui.auth.reset_title') }}</h1>
    <p class="gh-auth-sub">
        {{ t('ui.auth.forgot_sub') }}
        {% if not mail_enabled %}
            <br><span style="display:inline-block; margin-top:6px; font-size:12px; color:var(--gh-fg-muted);"><svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="vertical-align:-2px; margin-inline-end:4px;"><path d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/></svg>{{ t('ui.auth.mail_not_configured') }}</span>
        {% endif %}
    </p>

    {% if error %}
        <div class="gh-flash gh-flash-error gh-auth-error" role="alert">{{ error }}</div>
    {% endif %}
    {% if success %}
        <div class="gh-flash gh-flash-success gh-auth-error" role="status">{{ success }}</div>
    {% endif %}

    <div class="gh-auth-card">
        <form method="POST" action="/forgot-password" class="gh-auth-form">
            {% if csrf_token is defined %}
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% endif %}

            <div class="gh-form-group">
                <label class="gh-label" for="identifier">{{ t('ui.auth.username_or_email') }}</label>
                <input class="gh-input" type="text" id="identifier" name="identifier"
                       placeholder="{{ t_attr('ui.auth.username_placeholder')|default('username or you@example.com') }}" required autofocus
                       autocomplete="username" spellcheck="false">
            </div>

            <button type="submit" class="gh-btn gh-btn-primary gh-btn-block">{{ t('ui.auth.send_reset') }}</button>
        </form>
    </div>

    <div class="gh-auth-alt">
        {{ t('ui.auth.remembered_password') }} <a href="/login">{{ t('ui.auth.sign_in_link')|default(t('ui.auth.sign_in_btn')) }}</a>
    </div>

    <nav class="gh-auth-foot-links" aria-label="Footer">
        <a href="/terms">{{ t('ui.footer.terms')|default('Terms') }}</a>
        <a href="/privacy">{{ t('ui.footer.privacy')|default('Privacy') }}</a>
        <a href="/docs">{{ t('ui.nav.docs')|default('Docs') }}</a>
        <a href="/contact">{{ t('ui.nav.contact')|default('Contact') }}</a>
    </nav>
</section>
{% endblock %}