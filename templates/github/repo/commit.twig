{% extends "layout.twig" %}

{% block title %}{{ commit.hash[:8] }} — {{ repo.name }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page">
        {% include "partials/repo-header.twig" %}

    {% include "partials/repo-nav.twig" with { active_tab: 'commits' } %}

    {% set msg_lines = commit.message|split("\n") %}

    {# Commit header card #}
    <div class="gh-commit-head">
        <h2 class="gh-commit-subject">{{ msg_lines|first }}</h2>

        {% if msg_lines|length > 1 %}
            <pre class="gh-commit-body">{{ msg_lines|slice(1)|join("\n")|trim }}</pre>
        {% endif %}

        <div class="gh-commit-byline gh-commit-byline-lg">
            <span class="gh-commit-avatar" aria-hidden="true">{{ commit.author_name|slice(0, 1)|upper }}</span>
            <span class="gh-commit-author">{{ commit.author_name }}</span>
            <span class="gh-commit-when">committed <time datetime="{{ commit.date }}">{{ commit.date|time_ago }}</time></span>
        </div>

        <div class="gh-commit-meta-row">
            <span class="gh-hash-chip">
                <span class="gh-mono">{{ commit.hash[:7] }}</span>
                <button type="button" class="gh-copy-chip" data-copy="{{ commit.hash }}" aria-label="Copy full commit hash" title="Copy full hash">
                    <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg>
                </button>
            </span>

            {% if commit.parents|length > 0 %}
                <span class="gh-commit-parents">
                    <span>parent{{ commit.parents|length > 1 ? 's' : '' }}</span>
                    {% for parent in commit.parents %}
                        <a class="gh-mono" href="/{{ owner }}/{{ repo.slug }}/commit/{{ parent }}">{{ parent[:8] }}</a>{{ not loop.last ? ', ' : '' }}
                    {% endfor %}
                </span>
            {% endif %}
        </div>
    </div>

    {# Diffs #}
    {% if diff_files|length > 0 %}
        {% set diff_total = diff_stats.additions + diff_stats.deletions %}
        {% set greenBlocks = diff_total > 0 ? ((diff_stats.additions * 5) / diff_total)|round(0, 'floor') : 0 %}
        {% set redBlocks   = diff_total > 0 ? 5 - greenBlocks : 0 %}

        <div class="gh-diff-summary" role="status" aria-label="Commit change statistics">
            <div class="gh-ds-segment">
                <span class="gh-ds-num">{{ diff_stats.files }}</span>
                <span class="gh-ds-label">changed file{{ diff_stats.files != 1 ? 's' : '' }}</span>
            </div>
            <span class="gh-ds-separator" aria-hidden="true"></span>
            <div class="gh-ds-segment gh-ds-add">
                <span class="gh-ds-num">+{{ diff_stats.additions }}</span>
                <span class="gh-ds-label">addition{{ diff_stats.additions != 1 ? 's' : '' }}</span>
            </div>
            <span class="gh-ds-separator" aria-hidden="true"></span>
            <div class="gh-ds-segment gh-ds-del">
                <span class="gh-ds-num">&minus;{{ diff_stats.deletions }}</span>
                <span class="gh-ds-label">deletion{{ diff_stats.deletions != 1 ? 's' : '' }}</span>
            </div>
            <span class="gh-ds-spacer" aria-hidden="true"></span>
            {% if diff_total > 0 %}
                <span class="gh-diffstat" title="{{ diff_stats.additions }} addition{{ diff_stats.additions != 1 ? 's' : '' }}, {{ diff_stats.deletions }} deletion{{ diff_stats.deletions != 1 ? 's' : '' }}">
                    {% for i in 1..5 %}
                        <span class="gh-diffstat-block {{ i <= greenBlocks ? 'gh-db-add' : (i <= greenBlocks + redBlocks ? 'gh-db-del' : 'gh-db-muted') }}"></span>
                    {% endfor %}
                </span>
            {% endif %}
        </div>

        {# One card per changed file #}
        {% for file in diff_files %}
            <div class="gh-diff-file">
                <div class="gh-diff-file-head">
                    <span class="gh-status gh-status-{{ file.status }}">
                        {% if file.status == 'added' %}
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2Zm6.5 4.5v3h3a.75.75 0 0 1 0 1.5h-3v3a.75.75 0 0 1-1.5 0v-3h-3a.75.75 0 0 1 0-1.5h3v-3a.75.75 0 0 1 1.5 0Z"/></svg>
                        {% elseif file.status == 'deleted' %}
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2Zm2.75 7.25h6.5a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1 0-1.5Z"/></svg>
                        {% elseif file.status == 'renamed' %}
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.75 2.5h9.5a.75.75 0 0 1 0 1.5h-9.5a.75.75 0 0 1 0-1.5Zm5 10.25a.75.75 0 0 1 0-1.5h5.5a.75.75 0 0 1 0 1.5h-5.5ZM11.5 4.25a.75.75 0 0 1 .53.22l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L12.69 9.5 10.97 7.78a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734-.215Zm-7.75 3.5a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 0 1.5h-1.5Z"/></svg>
                        {% else %}
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.75 1.5a.25.25 0 0 0-.25.25v11.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V6H9.75A1.75 1.75 0 0 1 8 4.25V1.5H3.75Zm5.75.56v2.19c0 .138.112.25.25.25h2.19L9.5 2.06ZM2 1.75C2 .784 2.784 0 3.75 0h5.086c.464 0 .909.184 1.237.513l3.414 3.414c.329.328.513.773.513 1.237v8.086A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25Z"/></svg>
                        {% endif %}
                        <span>{{ file.status }}</span>
                    </span>
                    <span class="gh-diff-file-path">
                        {%- if file.old_path %}<span class="gh-mono">{{ file.old_path }}</span> <svg class="gh-rename-arrow" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Z"/></svg> {% endif -%}
                        <span class="gh-mono">{{ file.path }}</span>
                    </span>
                    <span class="gh-diff-file-counts">
                        <span class="gh-stat-add">+{{ file.additions }}</span>
                        <span class="gh-stat-del">&minus;{{ file.deletions }}</span>
                    </span>
                </div>

                {% if file.binary %}
                    <div class="gh-diff-note">Binary file not shown.</div>
                {% elseif file.lines|length == 0 and file.status == 'renamed' %}
                    <div class="gh-diff-note">File renamed without content changes.</div>
                {% else %}
                    <div class="gh-diff-scroll">
                        <table class="gh-diff-table">
                            <tbody>
                            {% for line in file.lines %}
                                {% if line.type == 'hunk' %}
                                    <tr class="gh-diff-hunk-row"><td colspan="4">{{ line.content }}</td></tr>
                                {% elseif line.type == 'meta' %}
                                    <tr class="gh-diff-meta-row"><td colspan="4">{{ line.content }}</td></tr>
                                {% else %}
                                    <tr class="gh-dl-{{ line.type }}">
                                        <td class="gh-dl-num">{{ line.old ?? '' }}</td>
                                        <td class="gh-dl-num">{{ line.new ?? '' }}</td>
                                        <td class="gh-dl-mark">{{ line.type == 'add' ? '+' : (line.type == 'del' ? '&minus;' : '') }}</td>
                                        <td class="gh-dl-code"><pre>{{ line.content }}</pre></td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if file.truncated %}
                        <div class="gh-diff-note">Large diffs are truncated — clone the repository to see the full change.</div>
                    {% endif %}
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <div class="gh-flash gh-flash-info">
            {% if commit.parents|length > 1 %}
                This is a merge commit with no conflicts — there are no file changes to display.
            {% else %}
                This commit has no file changes.
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
