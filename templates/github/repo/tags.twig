{% extends "layout.twig" %}

{% block title %}{{ t('ui.tags.tags') }} · {{ repo.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page">
    {% include "partials/repo-header.twig" %}

    {% include "partials/repo-nav.twig" with { active_tab: 'tags' } %}

    <!-- Subnav Tabs (Releases / Tags) + Draft Button -->
    <div class="gh-subnav" style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <nav class="gh-subnav-links" aria-label="{{ t_attr('ui.releases.releases') }} and {{ t_attr('ui.tags.tags') }}">
            <a href="/{{ owner }}/{{ repo.slug }}/releases" class="gh-subnav-item">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="m8.878.392 5.25 3.045c.54.314.872.89.872 1.514v6.098a1.75 1.75 0 0 1-.872 1.514l-5.25 3.045a1.75 1.75 0 0 1-1.756 0l-5.25-3.045A1.75 1.75 0 0 1 1 11.049V4.951c0-.624.332-1.201.872-1.514L7.122.392a1.75 1.75 0 0 1 1.756 0ZM7.875 1.69l-4.63 2.685L8 7.133l4.755-2.758-4.63-2.685a.248.248 0 0 0-.25 0ZM2.5 5.677v5.372c0 .09.047.171.125.216l4.625 2.683V8.413L2.5 5.677Zm11 0-4.75 2.736v5.535l4.625-2.683a.25.25 0 0 0 .125-.216V5.677Z"/></svg>
                <span>{{ t('ui.releases.releases') }}</span>
                <span class="gh-tab-count">{{ releases_count|default(0) }}</span>
            </a>
            <a href="/{{ owner }}/{{ repo.slug }}/tags" class="gh-subnav-item selected">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25v5.025ZM6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/></svg>
                <span>{{ t('ui.tags.tags') }}</span>
                <span class="gh-tab-count">{{ tags|length }}</span>
            </a>
        </nav>

        {% if can_write %}
            <a href="/{{ owner }}/{{ repo.slug }}/releases/new" class="gh-btn gh-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M7.75 2a.75.75 0 0 1 .75.75V7h4.25a.75.75 0 0 1 0 1.5H8.5v4.25a.75.75 0 0 1-1.5 0V8.5H2.75a.75.75 0 0 1 0-1.5H7V2.75A.75.75 0 0 1 7.75 2Z"/></svg>
                <span>{{ t('ui.releases.draft_release') }}</span>
            </a>
        {% endif %}
    </div>

    <!-- Tags List -->
    {% if tags|length > 0 %}
        <div class="gh-box" style="margin-top: 16px;">
            <div class="gh-box-header">
                <h2 class="gh-box-title">{{ t('ui.tags.tag_count', {'count': tags|length}) }}</h2>
            </div>

            <div class="gh-table-wrap" style="border: none; border-radius: 0;">
                <table class="gh-table">
                    <tbody>
                        {% for t in tags %}
                            <tr>
                                <!-- Tag Name & Ref Details -->
                                <td style="width: 280px;">
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                        <svg width="14" height="14" viewBox="0 0 16 16" fill="var(--gh-fg-muted)"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25v5.025ZM6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/></svg>
                                        <a href="/{{ owner }}/{{ repo.slug }}/releases/tag/{{ t.name|url_encode }}" style="font-weight: 600; font-size: 14px; color: var(--gh-accent-fg); text-decoration: none; font-family: var(--gh-font-mono);" title="View release notes & downloads">
                                            {{ t.name }}
                                        </a>

                                        <!-- Browse Code at Tag Button -->
                                        <a href="/{{ owner }}/{{ repo.slug }}/tree/{{ t.name|url_encode }}" class="gh-btn gh-btn-sm" style="font-size: 11px; padding: 1px 6px; color: var(--gh-fg-muted);" title="Browse repository code at this tag">
                                            &lt;/&gt; Code
                                        </a>

                                        {% if t.has_release|default(false) %}
                                            <a href="/{{ owner }}/{{ repo.slug }}/releases/tag/{{ t.name|url_encode }}" class="gh-badge" style="background: rgba(63,185,80,0.15); color: #3fb950; border: 1px solid rgba(63,185,80,0.3); font-size: 11px; text-decoration: none;" title="View official release notes">
                                                Release
                                            </a>
                                        {% endif %}
                                    </div>
                                    <div style="font-size: 12px; color: var(--gh-fg-muted); display: flex; align-items: center; gap: 6px; padding-left: 22px; margin-top: 2px;">
                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0ZM8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Z"/></svg>
                                        <a href="/{{ owner }}/{{ repo.slug }}/commit/{{ t.hash }}" class="gh-mono" style="color: var(--gh-fg-muted); text-decoration: none;">
                                            {{ t.short_hash }}
                                        </a>
                                    </div>
                                </td>

                                <!-- Tag Message / Subject -->
                                <td>
                                    <span style="font-size: 13px; color: var(--gh-fg-default);">
                                        {{ t.subject ?: t('ui.tags.tag_commit', {'hash': t.short_hash}) }}
                                    </span>
                                </td>

                                <!-- Date Timestamp -->
                                <td style="font-size: 12px; color: var(--gh-fg-muted); white-space: nowrap; width: 140px;">
                                    <time datetime="{{ t.date }}">{{ t.date|time_ago }}</time>
                                </td>

                                <!-- Download & Share Actions -->
                                <td style="text-align: right; white-space: nowrap; width: 180px;">
                                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                                        <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/archive/{{ t.name }}.zip" title="{{ t_attr('ui.tags.download_zip') }}">
                                            zip
                                        </a>
                                        <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/archive/{{ t.name }}.tar.gz" title="{{ t_attr('ui.tags.download_tar') }}">
                                            tar.gz
                                        </a>
                                        <button type="button" class="gh-btn gh-btn-sm" onclick="openDownloadModal('repo_archive', '{{ repo.slug }}', '{{ t.name }}', '', 'Tag: {{ t.name }} ({{ repo.name }})', '/{{ owner }}/{{ repo.slug }}/archive/{{ t.name }}.zip')" title="{{ t_attr('ui.tags.share_link') }}">
                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M7.775 3.275a.75.75 0 0 0 1.06 1.06l1.25-1.25a2 2 0 1 1 2.83 2.83l-2.5 2.5a2 2 0 0 1-2.83 0 .75.75 0 0 0-1.06 1.06 3.5 3.5 0 0 0 4.95 0l2.5-2.5a3.5 3.5 0 0 0-4.95-4.95l-1.25 1.25Zm-4.69 9.64a2 2 0 0 1 0-2.83l2.5-2.5a2 2 0 0 1 2.83 0 .75.75 0 0 0 1.06-1.06 3.5 3.5 0 0 0-4.95 0l-2.5 2.5a3.5 3.5 0 0 0 4.95 4.95l1.25-1.25a.75.75 0 0 0-1.06-1.06l-1.25 1.25a2 2 0 0 1-2.83 0Z"/></svg>
                                        </button>
                                    </div>
                                </td>

                                {% if can_write %}
                                    <!-- Writer Actions: Convert Tag to Release / Edit Release / Delete Tag -->
                                    <td style="text-align: right; white-space: nowrap; width: 220px;">
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            {% if not t.has_release|default(false) %}
                                                <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/releases/new?tag={{ t.name|url_encode }}" style="display: inline-flex; align-items: center; gap: 4px; color: var(--gh-accent-fg); font-weight: 600;" title="{{ t_attr('ui.releases.create_release_from_tag') }}">
                                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="m8.878.392 5.25 3.045c.54.314.872.89.872 1.514v6.098a1.75 1.75 0 0 1-.872 1.514l-5.25 3.045a1.75 1.75 0 0 1-1.756 0l-5.25-3.045A1.75 1.75 0 0 1 1 11.049V4.951c0-.624.332-1.201.872-1.514L7.122.392a1.75 1.75 0 0 1 1.756 0ZM7.875 1.69l-4.63 2.685L8 7.133l4.755-2.758-4.63-2.685a.248.248 0 0 0-.25 0ZM2.5 5.677v5.372c0 .09.047.171.125.216l4.625 2.683V8.413L2.5 5.677Zm11 0-4.75 2.736v5.535l4.625-2.683a.25.25 0 0 0 .125-.216V5.677Z"/></svg>
                                                    <span>{{ t('ui.releases.create_release_from_tag') }}</span>
                                                </a>
                                            {% else %}
                                                <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/releases/{{ t.release_id }}/edit" style="display: inline-flex; align-items: center; gap: 4px;" title="{{ t_attr('ui.releases.edit_release') }}">
                                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25a1.75 1.75 0 0 1 .445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM9.75 4.81l-6.286 6.287a.249.249 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064L11.19 6.25 9.75 4.81Z"/></svg>
                                                    <span>{{ t('ui.releases.edit_release') }}</span>
                                                </a>
                                            {% endif %}
                                            <form method="POST" action="/{{ owner }}/{{ repo.slug }}/tags/delete" onsubmit="return confirm('{{ t_attr('ui.releases.delete_tag_confirm', {'tag': t.name})|e('js') }}');" style="margin: 0;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                <input type="hidden" name="tag" value="{{ t.name }}">
                                                <button type="submit" class="gh-btn gh-btn-sm" style="color: var(--gh-danger-fg);" title="{{ t_attr('ui.releases.delete_tag_confirm', {'tag': t.name}) }}">
                                                    {{ t('common.delete')|default('Delete') }}
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="gh-box" style="text-align: center; padding: 48px 20px; background: var(--gh-bg-canvas); margin-top: 16px;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: var(--gh-bg-subtle); color: var(--gh-fg-muted); margin-bottom: 12px;">
                <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor"><path d="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.752 1.752 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25v5.025ZM6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/></svg>
            </div>
            <h3 style="font-size: 16px; font-weight: 600; color: var(--gh-fg-default); margin: 0 0 6px 0;">
                {{ t('ui.tags.empty_title') }}
            </h3>
            <p style="color: var(--gh-fg-muted); font-size: 13px; max-width: 460px; margin: 0 auto 16px auto;">
                {{ t('ui.tags.empty_desc') }}
            </p>
        </div>
    {% endif %}
</div>

{% include "partials/download-modal.twig" %}
{% endblock %}
