{% extends "layout.twig" %}

{% block title %}{{ segments|last }} — {{ repo.name }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page">
        {% include "partials/repo-header.twig" %}

    {% include "partials/repo-nav.twig" with { active_tab: 'code' } %}

    {# Toolbar with Branch Selector & Breadcrumbs #}
    <div style="display: flex; align-items: center; justify-content: space-between; margin: 16px 0 12px 0; gap: 12px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            {% if branches is defined and branches|length > 0 %}
                {% set ref_base = "/" ~ owner ~ "/" ~ repo.slug ~ "/blob" %}
                {% include "partials/ref-selector.twig" with { base_url: ref_base } %}
            {% endif %}

            <nav class="gh-breadcrumb" aria-label="Breadcrumb" style="margin: 0;">
                <a href="/{{ owner }}/{{ repo.slug }}/tree/{{ current_ref }}">{{ repo.slug }}</a>
                {% for seg in segments %}
                    <span class="sep">/</span>
                    {% if not loop.last %}
                        {% set seg_path = segments[0:loop.index]|join('/') %}
                        <a href="/{{ owner }}/{{ repo.slug }}/tree/{{ current_ref }}/{{ seg_path }}">{{ seg }}</a>
                    {% else %}
                        <strong>{{ seg }}</strong>
                    {% endif %}
                {% endfor %}
            </nav>
        </div>

        <a href="/{{ owner }}/{{ repo.slug }}/commits/{{ current_ref }}/{{ current_path }}" class="gh-btn gh-btn-sm" style="display: flex; align-items: center; gap: 5px;">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.751.751 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0Z"/></svg>
            <span>{{ t('ui.repo.history') }}</span>
        </a>
    </div>

    {% if too_large %}
        <div class="gh-flash gh-flash-error">
            This file is too large to display ({{ file_size|number_format }} bytes). Files larger than 1 MB are not shown inline.
        </div>
    {% elseif content is null %}
        <div class="gh-flash gh-flash-error">
            File content could not be loaded.
        </div>
    {% else %}
        {# Code view with line numbers (+ rendered Markdown preview) #}
        <div class="gh-code-view">
            {% if is_markdown and markdown_html %}
                <input type="radio" name="blobview" id="gh-bv-preview" class="gh-blobview-input" checked>
                <input type="radio" name="blobview" id="gh-bv-source" class="gh-blobview-input">
            {% endif %}
            <div class="gh-code-head">
                <div class="gh-code-meta">
                    {{ file_icon(segments|last, 'blob') }}
                    <span class="gh-mono">{{ segments|last }}</span>
                    <span>{{ content|split("\n")|length }} lines · {{ file_size|number_format }} bytes</span>
                    <span class="gh-code-ref">
                        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"/></svg>
                        <span class="gh-mono">{{ current_ref }}</span>
                    </span>
                </div>
                <div class="gh-code-actions">
                    {% if is_markdown and markdown_html %}
                        <div class="gh-blob-toggle" role="tablist" aria-label="View mode">
                            <label for="gh-bv-preview">Preview</label>
                            <label for="gh-bv-source">Code</label>
                        </div>
                    {% endif %}
                    {% if can_write %}
                        <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/edit/{{ current_ref }}/{{ current_path }}" title="Edit file in web editor">
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064L11.19 6.25 9.75 4.81Z"/></svg>
                            Edit
                        </a>
                        <button type="button" class="gh-btn gh-btn-sm gh-btn-danger" title="Delete this file (creates a revertible commit)"
                                onclick="openDeleteModal('{{ current_ref|e('js') }}', '{{ current_path|e('js') }}', '{{ segments|last|e('js') }}')">
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"/></svg>
                            Delete
                        </button>
                    {% endif %}
                    <a class="gh-btn gh-btn-sm" href="/{{ owner }}/{{ repo.slug }}/blame/{{ current_ref }}/{{ current_path }}">Blame</a>
                    <a class="gh-btn gh-btn-sm" href="{{ raw_url }}" target="_blank" rel="noopener">Raw</a>
                    <button type="button" class="gh-btn gh-btn-sm" onclick="openDownloadModal('blob', '{{ repo.slug }}', '{{ current_ref }}', '{{ current_path }}', 'File: {{ segments|last }}', '{{ raw_url }}')" title="Download or create encrypted short link">
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>
                        <span>{{ t('ui.repo.download') }}</span>
                    </button>
                </div>
            </div>
            {% if is_markdown and markdown_html %}
                <div class="gh-blob-rendered markdown-body">{{ markdown_html|raw }}</div>
            {% endif %}
            <div class="gh-code-scroll">
                <table class="gh-code-table">
                    <tbody>
                        {% for line in content|split("\n") %}
                            <tr id="L{{ loop.index }}">
                                <td class="ln"><a href="#L{{ loop.index }}">{{ loop.index }}</a></td>
                                <td class="lc"><pre><code class="hljs">{{ line }}</code></pre></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>

{% include "partials/download-modal.twig" %}
{% if can_write %}
    {% include "partials/delete-file-modal.twig" %}
{% endif %}
{% endblock %}

{% block scripts %}
    {# highlight.js init lives in assets/js/main.js (CSP forbids inline scripts) #}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"
            integrity="sha512-D9gUyxqja7hBtkWpPWGt9wfbfaMGVt9gnyCvYa+jojwwPHLCzUm5i8rpk7vD7wNee9bA35eYIjobYPaQuKS1MQ==" crossorigin="anonymous"></script>
{% endblock %}
