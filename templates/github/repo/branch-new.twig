{% extends "layout.twig" %}

{% block title %}New branch — {{ repo.name }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page">
        {% include "partials/repo-header.twig" %}

    {% include "partials/repo-nav.twig" with { active_tab: 'branches' } %}

    <div class="gh-form-container" style="max-width: 650px; margin: 2rem auto; background: var(--gh-bg-secondary); border: 1px solid var(--gh-border); border-radius: 8px; padding: 1.5rem;">
        <h2 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"/></svg>
            Create a new branch
        </h2>
        <p style="color: var(--gh-text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
            Branches allow you to work on new features or bug fixes without affecting the main codebase.
        </p>

        <form method="POST" action="/{{ owner }}/{{ repo.slug }}/branches/new">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div style="margin-bottom: 1.25rem;">
                <label for="branch_name" style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">
                    Branch name <span style="color: var(--gh-danger);">*</span>
                </label>
                <input type="text" id="branch_name" name="branch_name" required autofocus
                       placeholder="e.g. feature/user-profile or bugfix-123"
                       pattern="[a-zA-Z0-9._\-\/]+"
                       style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid var(--gh-border); border-radius: 6px; background: var(--gh-bg); color: var(--gh-text); font-family: monospace; font-size: 0.95rem;">
                <small style="display: block; margin-top: 0.25rem; color: var(--gh-text-muted);">
                    Use alphanumeric characters, hyphens, slashes, or underscores.
                </small>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label for="from_ref" style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">
                    Create from branch or commit
                </label>
                <select id="from_ref" name="from_ref"
                        style="width: 100%; padding: 0.5rem 0.75rem; border: 1px solid var(--gh-border); border-radius: 6px; background: var(--gh-bg); color: var(--gh-text); font-size: 0.95rem;">
                    {% for b in branches %}
                        <option value="{{ b }}"{{ b == from_ref ? ' selected' : '' }}>{{ b }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center;">
                <button type="submit" class="gh-btn gh-btn-primary">
                    Create branch
                </button>
                <a href="/{{ owner }}/{{ repo.slug }}/branches" class="gh-btn">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
