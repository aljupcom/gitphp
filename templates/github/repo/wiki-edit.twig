{% extends "layout.twig" %}

{% block title %}
    {% if page is defined and page %}
        {{ t('ui.wiki.edit_page_title') }} · {{ page.title }} · {{ repo.name }}
    {% else %}
        {{ t('ui.wiki.new_page_title') }} · {{ repo.name }}
    {% endif %}
    — {{ app_name }}
{% endblock %}

{% block content %}
<div class="gh-page">
    {% include "partials/repo-header.twig" %}

    {% include "partials/repo-nav.twig" with { active_tab: 'wiki' } %}

    <div class="gh-wiki-edit-wrapper">
        <h1 class="gh-wiki-edit-heading">
            {% if page is defined and page %}
                {{ t('ui.wiki.edit_page_title') }}
            {% else %}
                {{ t('ui.wiki.new_page_title') }}
            {% endif %}
        </h1>

        {% if error %}
            <div class="gh-flash gh-flash-error" role="alert">
                {{ error }}
            </div>
        {% endif %}

        {% set is_edit = page is defined and page %}
        {% set old_title = old.title is defined ? old.title : (is_edit ? page.title : '') %}
        {% set old_content = old.content is defined ? old.content : (is_edit ? page.content : '') %}

        <form method="POST"
              action="{{ is_edit ? '/' ~ owner ~ '/' ~ repo.slug ~ '/wiki/' ~ page.slug ~ '/update' : '/' ~ owner ~ '/' ~ repo.slug ~ '/wiki' }}"
              class="gh-wiki-edit-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="gh-form-group">
                <label class="gh-label" for="wiki-title">{{ t('ui.wiki.page_title') }}</label>
                <input class="gh-input" type="text" id="wiki-title" name="title" maxlength="255" required
                       value="{{ old_title }}"
                       placeholder="{{ t_attr('ui.wiki.title_placeholder') }}">
            </div>

            {% if not is_edit %}
                <div class="gh-form-group">
                    <label class="gh-label" for="wiki-slug">{{ t('ui.wiki.page_url') }}</label>
                    <div class="gh-wiki-slug-row">
                        <span class="gh-wiki-slug-prefix">/{{ owner }}/{{ repo.slug }}/wiki/</span>
                        <input class="gh-input" type="text" id="wiki-slug" name="slug"
                               value="{{ old.slug is defined ? old.slug : '' }}"
                               placeholder="my-page" spellcheck="false"
                               pattern="[a-zA-Z0-9][a-zA-Z0-9._-]*">
                    </div>
                    <p class="gh-form-hint">{{ t('ui.wiki.slug_hint') }}</p>
                </div>
            {% endif %}

            <div class="gh-form-group">
                <div class="gh-wiki-editor-toolbar">
                    <span class="gh-wiki-editor-label">{{ t('ui.wiki.content_label') }}</span>
                    <div class="gh-md-toolbar" data-md-target="wiki-content" role="toolbar" aria-label="Markdown formatting">
                        <button type="button" class="gh-icon-btn" data-md-action="bold" title="{{ t_attr('ui.wiki.bold') }}" aria-label="{{ t_attr('ui.wiki.bold') }}"><strong>B</strong></button>
                        <button type="button" class="gh-icon-btn" data-md-action="italic" title="{{ t_attr('ui.wiki.italic') }}" aria-label="{{ t_attr('ui.wiki.italic') }}"><em>I</em></button>
                        <button type="button" class="gh-icon-btn" data-md-action="h2" title="{{ t_attr('ui.wiki.heading') }}" aria-label="{{ t_attr('ui.wiki.heading') }}">H</button>
                        <button type="button" class="gh-icon-btn" data-md-action="link" title="{{ t_attr('ui.wiki.link') }}" aria-label="{{ t_attr('ui.wiki.link') }}">
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"/></svg>
                        </button>
                        <button type="button" class="gh-icon-btn" data-md-action="code" title="{{ t_attr('ui.wiki.code') }}" aria-label="{{ t_attr('ui.wiki.code') }}"><code>`</code></button>
                        <button type="button" class="gh-icon-btn" data-md-action="codeblock" title="{{ t_attr('ui.wiki.codeblock') }}" aria-label="{{ t_attr('ui.wiki.codeblock') }}">
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="m4.72 3.22a.749.749 0 0 1 1.06 0l3.25 3.25a.749.749 0 0 1 0 1.06L5.78 10.78a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L7.44 7.5 4.72 4.78a.75.75 0 0 1 0-1.06Zm6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L9.84 7.5l2.5 2.5a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215l-2.5-2.5a.75.75 0 0 1 0-1.06l2.5-2.5a.75.75 0 0 1 1.06-.28Z"/></svg>
                        </button>
                        <button type="button" class="gh-icon-btn" data-md-action="ul" title="{{ t_attr('ui.wiki.ul') }}" aria-label="{{ t_attr('ui.wiki.ul') }}">
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm3.75-1.5a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5Zm0 5a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5Zm0 5a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5ZM2 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm-1 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
                        </button>
                        <button type="button" class="gh-icon-btn" data-md-action="ol" title="{{ t_attr('ui.wiki.ol') }}" aria-label="{{ t_attr('ui.wiki.ol') }}">
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-3Zm2.75 1.75a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5Zm0 5a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5Zm0 5a.75.75 0 0 1 0-1.5h8.5a.75.75 0 0 1 0 1.5h-8.5ZM1.75 8.25a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm-.748 5.061a.75.75 0 0 1 .82-.061l1.5.75a.75.75 0 0 1-.06 1.383l-1.5.75a.75.75 0 0 1-.75-1.29l.23-.12-1.104-.296a.75.75 0 0 1 .864-1.116ZM6.75 10.25a.75.75 0 0 1 .75-.75H9.25a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-.75.75H7.5v1h1.75a.75.75 0 0 1 0 1.5H7.5v1h1.75a.75.75 0 0 1 0 1.5H7.5a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 1 .75-.75Z"/></svg>
                        </button>
                        <button type="button" class="gh-icon-btn" data-md-action="quote" title="{{ t_attr('ui.wiki.quote') }}" aria-label="{{ t_attr('ui.wiki.quote') }}">
                            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.75 2.5h10.5a.75.75 0 0 1 0 1.5H1.75a.75.75 0 0 1 0-1.5Zm4 5h8.5a.75.75 0 0 1 0 1.5h-8.5a.75.75 0 0 1 0-1.5Zm0 5h8.5a.75.75 0 0 1 0 1.5h-8.5a.75.75 0 0 1 0-1.5ZM2.5 7.75v6A1.75 1.75 0 0 1 .75 12v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h1.75V7.75a.75.75 0 0 1 1.5 0Z"/></svg>
                        </button>
                    </div>
                </div>
                <textarea class="gh-input gh-textarea gh-wiki-textarea" id="wiki-content" name="content" rows="16"
                          data-md-editor="1" data-md-preview-url="/{{ owner }}/{{ repo.slug }}/wiki/preview"
                          placeholder="{{ t_attr('ui.wiki.content_placeholder') }}">{{ old_content }}</textarea>
            </div>

            <div class="gh-form-actions">
                <a class="gh-btn" href="/{{ owner }}/{{ repo.slug }}/wiki">{{ t('ui.wiki.cancel') }}</a>
                <button type="submit" class="gh-btn gh-btn-primary">{{ t('ui.wiki.save_page') }}</button>
            </div>
        </form>

        {% if is_edit %}
            <form method="POST" action="/{{ owner }}/{{ repo.slug }}/wiki/{{ page.slug }}/delete" class="gh-wiki-delete-form"
                  data-confirm="{{ t_attr('ui.wiki.delete_confirm') }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="gh-btn gh-btn-danger">{{ t('ui.wiki.delete_page') }}</button>
            </form>
        {% endif %}

        {# Live Markdown preview pane (filled by main.js, CSP-safe fetch) #}
        <div class="gh-wiki-preview" id="gh-wiki-preview" hidden>
            <div class="gh-wiki-preview-head">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                <span>{{ t('ui.wiki.preview') }}</span>
            </div>
            <div class="markdown-body gh-wiki-preview-body"></div>
        </div>
    </div>
</div>
{% endblock %}
