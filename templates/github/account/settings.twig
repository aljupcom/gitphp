{% extends "layout.twig" %}

{% block title %}
    {% if active_tab == 'account' %}
        Account settings · {{ app_name }}
    {% elseif active_tab == 'security' %}
        Password and authentication · {{ app_name }}
    {% elseif active_tab == 'keys' %}
        SSH keys · {{ app_name }}
    {% elseif active_tab == 'updates' %}
        Remote updates · {{ app_name }}
    {% else %}
        Public profile · {{ app_name }}
    {% endif %}
{% endblock %}

{% block content %}
<div class="gh-page" style="max-width: 1040px; margin: 0 auto; padding: 24px 16px;">

    {# Mobile Navigation Dropdown (<= 768px) #}
    <div class="gh-settings-mobile-nav" style="display: none; margin-bottom: 20px;">
        <label for="settings-mobile-select" style="display: block; font-size: 12px; font-weight: 600; color: var(--gh-fg-muted); margin-bottom: 6px;">Settings Menu</label>
        <select id="settings-mobile-select" class="gh-form-control" onchange="if(this.value) window.location.href=this.value;" style="width: 100%; height: 38px; font-size: 13.5px; font-weight: 500;">
            <option value="/settings/account?tab=profile" {% if active_tab == 'profile' %}selected{% endif %}>👤 Public profile</option>
            <option value="/settings/account?tab=account" {% if active_tab == 'account' %}selected{% endif %}>⚙️ Account</option>
            <option value="/settings/account?tab=security" {% if active_tab == 'security' %}selected{% endif %}>🔒 Password and authentication</option>
            <option value="/settings/tokens">🔑 Personal access tokens</option>
        </select>
    </div>

    <div class="gh-settings-layout" style="display: flex; gap: 28px; align-items: flex-start;">

        {# ── LEFT SIDEBAR (GitHub Exact Clone) ── #}
        <aside class="gh-settings-sidebar" style="width: 240px; flex-shrink: 0;">
            {# User mini card #}
            <div style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; margin-bottom: 12px; border-radius: 6px; background: var(--gh-bg-subtle); border: 1px solid var(--gh-border-default);">
                {% if user.avatar_path %}
                    <img src="{{ user.avatar_path }}" alt="{{ user.display_name|default(user.username) }}" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--gh-border-default);">
                {% else %}
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #238636; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px;">
                        {{ (user.display_name|default(user.username)|first)|upper }}
                    </div>
                {% endif %}
                <div style="min-width: 0; flex: 1;">
                    <div style="font-weight: 600; font-size: 13.5px; color: var(--gh-fg-default); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        {{ user.display_name|default(user.username) }}
                    </div>
                    <div style="font-size: 12px; color: var(--gh-fg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @{{ user.username }}
                    </div>
                </div>
            </div>

            <nav class="gh-nav-list" style="display: flex; flex-direction: column; gap: 2px;">
                <div style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; color: var(--gh-fg-muted); padding: 6px 10px; letter-spacing: 0.5px;">
                    Access
                </div>

                <a href="/settings/account?tab=profile" class="gh-nav-item {% if active_tab == 'profile' %}active{% endif %}"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: {% if active_tab == 'profile' %}var(--gh-fg-default){% else %}var(--gh-fg-muted){% endif %}; background: {% if active_tab == 'profile' %}var(--gh-bg-subtle){% else %}transparent{% endif %}; border-left: 3px solid {% if active_tab == 'profile' %}#fd8c73{% else %}transparent{% endif %};">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M10.561 8.073a6.005 6.005 0 0 1 3.432 5.142.75.75 0 1 1-1.498.07 4.5 4.5 0 0 0-8.99 0 .75.75 0 0 1-1.498-.07 6.004 6.004 0 0 1 3.431-5.142 3.999 3.999 0 1 1 5.123 0ZM10.5 5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"></path>
                    </svg>
                    <span>Public profile</span>
                </a>

                <a href="/settings/account?tab=account" class="gh-nav-item {% if active_tab == 'account' %}active{% endif %}"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: {% if active_tab == 'account' %}var(--gh-fg-default){% else %}var(--gh-fg-muted){% endif %}; background: {% if active_tab == 'account' %}var(--gh-bg-subtle){% else %}transparent{% endif %}; border-left: 3px solid {% if active_tab == 'account' %}#fd8c73{% else %}transparent{% endif %};">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1.5a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-3.5a.75.75 0 0 1 0-1.5h.25V8.5h-.25A.75.75 0 0 1 6.5 7.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path>
                    </svg>
                    <span>Account</span>
                </a>

                <a href="/settings/account?tab=security" class="gh-nav-item {% if active_tab == 'security' %}active{% endif %}"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: {% if active_tab == 'security' %}var(--gh-fg-default){% else %}var(--gh-fg-muted){% endif %}; background: {% if active_tab == 'security' %}var(--gh-bg-subtle){% else %}transparent{% endif %}; border-left: 3px solid {% if active_tab == 'security' %}#fd8c73{% else %}transparent{% endif %};">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M8 1a3.5 3.5 0 0 0-3.5 3.5v2H3.75C2.784 6.5 2 7.284 2 8.25v5.5c0 .966.784 1.75 1.75 1.75h8.5A1.75 1.75 0 0 0 14 13.75v-5.5C14 7.284 13.216 6.5 12.25 6.5h-.75v-2A3.5 3.5 0 0 0 8 1Zm2 5.5H6v-2a2 2 0 1 1 4 0v2Z"></path>
                    </svg>
                    <span>Password &amp; authentication</span>
                </a>

                <a href="/settings/keys" class="gh-nav-item {% if active_tab == 'keys' %}active{% endif %}"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: {% if active_tab == 'keys' %}var(--gh-fg-default){% else %}var(--gh-fg-muted){% endif %}; background: {% if active_tab == 'keys' %}var(--gh-bg-subtle){% else %}transparent{% endif %}; border-left: 3px solid {% if active_tab == 'keys' %}#fd8c73{% else %}transparent{% endif %};">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M6.5 0A6.5 6.5 0 0 0 0 6.5c0 2.766 1.73 5.127 4.17 6.069l-.67 2.012A.75.75 0 0 0 4.21 15.5h2.58a.75.75 0 0 0 .71-.513l.62-1.859A6.5 6.5 0 0 0 13 6.5 6.5 6.5 0 0 0 6.5 0Zm0 1.5a5 5 0 1 1 0 10 5 5 0 0 1 0-10ZM5 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"></path>
                    </svg>
                    <span>SSH keys</span>
                </a>

                <a href="/settings/updates" class="gh-nav-item {% if active_tab == 'updates' %}active{% endif %}"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: {% if active_tab == 'updates' %}var(--gh-fg-default){% else %}var(--gh-fg-muted){% endif %}; background: {% if active_tab == 'updates' %}var(--gh-bg-subtle){% else %}transparent{% endif %}; border-left: 3px solid {% if active_tab == 'updates' %}#fd8c73{% else %}transparent{% endif %};">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-2H2.75a.25.25 0 0 0-.25.25V6h11v-.25a.25.25 0 0 0-.25-.25Z"></path>
                    </svg>
                    <span>{{ t('ui.remote_updates.tab_title') }}</span>
                </a>

                <div style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; color: var(--gh-fg-muted); padding: 14px 10px 6px; letter-spacing: 0.5px;">
                    Developer settings
                </div>

                <a href="/settings/tokens" class="gh-nav-item"
                   style="display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; text-decoration: none; font-weight: 500; color: var(--gh-fg-muted); border-left: 3px solid transparent;">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M6.5 0a6.5 6.5 0 0 0-5.84 9.39L.15 9.9a.75.75 0 0 0 0 1.06l1.5 1.5a.75.75 0 0 0 .53.22h.72l.47.47a.75.75 0 0 0 .53.22h1.5a.75.75 0 0 0 .53-.22l1.22-1.22A6.5 6.5 0 1 0 6.5 0ZM2.5 6.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z"></path>
                    </svg>
                    <span>Personal access tokens</span>
                </a>
            </nav>
        </aside>

        {# ── RIGHT MAIN CONTENT AREA ── #}
        <main class="gh-settings-content" style="flex: 1; min-width: 0;">



            {# ══════════════════════════════════════════════════════════════ #}
            {# TAB 1: PUBLIC PROFILE                                          #}
            {# ══════════════════════════════════════════════════════════════ #}
            {% if active_tab == 'profile' %}
                <div style="border-bottom: 1px solid var(--gh-border-default); padding-bottom: 12px; margin-bottom: 24px;">
                    <h1 style="font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">Public profile</h1>
                    <span style="font-size: 13px; color: var(--gh-fg-muted);">Information about you that is public on your profile.</span>
                </div>

                <form method="post" action="/settings/account/profile" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                    <div style="display: flex; gap: 36px; flex-wrap: wrap-reverse; align-items: flex-start;">
                        
                        {# Left Form Column #}
                        <div style="flex: 1; min-width: 280px; max-width: 480px;">
                            
                            {# Display Name #}
                            <div style="margin-bottom: 16px;">
                                <label for="profile-name" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Name
                                </label>
                                <input type="text" id="profile-name" name="display_name" value="{{ user.display_name }}" placeholder="Your full name" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;">
                                <span style="font-size: 12px; color: var(--gh-fg-muted); display: block; margin-top: 4px;">Your name may appear around GitPHP where you contribute or are mentioned.</span>
                            </div>

                            {# Public Email (Info) #}
                            <div style="margin-bottom: 16px;">
                                <label style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Public email
                                </label>
                                <input type="text" readonly value="{{ user.email }}" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px; background: var(--gh-bg-subtle); color: var(--gh-fg-muted); cursor: not-allowed;">
                                <span style="font-size: 12px; color: var(--gh-fg-muted); display: block; margin-top: 4px;">You can change your email address in <a href="/settings/account?tab=account" style="color: #58a6ff; text-decoration: none;">Account settings</a>.</span>
                            </div>

                            {# Bio #}
                            <div style="margin-bottom: 16px;">
                                <label for="profile-bio" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Bio
                                </label>
                                <textarea id="profile-bio" name="bio" rows="3" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 8px 10px; resize: vertical;" placeholder="Tell us a little bit about yourself">{{ user.bio }}</textarea>
                                <span style="font-size: 12px; color: var(--gh-fg-muted); display: block; margin-top: 4px;">You can @mention other users and organizations.</span>
                            </div>

                            {# Company #}
                            <div style="margin-bottom: 16px;">
                                <label for="profile-company" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Company
                                </label>
                                <input type="text" id="profile-company" name="company" value="{{ user.company }}" placeholder="Organization / Company" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;">
                            </div>

                            {# Location #}
                            <div style="margin-bottom: 16px;">
                                <label for="profile-location" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Location
                                </label>
                                <input type="text" id="profile-location" name="location" value="{{ user.location }}" placeholder="e.g. San Francisco, CA" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;">
                            </div>

                            {# Website #}
                            <div style="margin-bottom: 16px;">
                                <label for="profile-website" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Website
                                </label>
                                <input type="url" id="profile-website" name="website" value="{{ user.website }}" placeholder="https://example.com" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;" dir="ltr">
                            </div>

                            {# Twitter #}
                            <div style="margin-bottom: 24px;">
                                <label for="profile-twitter" style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                    Social accounts / Twitter
                                </label>
                                <div style="display: flex; align-items: center;">
                                    <span style="background: var(--gh-bg-subtle); border: 1px solid var(--gh-border-default); border-right: none; padding: 6px 10px; font-size: 13.5px; color: var(--gh-fg-muted); border-radius: 6px 0 0 6px;">@</span>
                                    <input type="text" id="profile-twitter" name="twitter" value="{{ user.twitter }}" placeholder="username" class="gh-form-control" style="flex: 1; font-size: 13.5px; padding: 6px 10px; border-radius: 0 6px 6px 0;" dir="ltr">
                                </div>
                            </div>

                            <button type="submit" class="gh-btn gh-btn-primary" style="font-weight: 600; padding: 7px 18px;">
                                Update profile
                            </button>
                        </div>

                        {# Right Profile Picture Column #}
                        <div style="width: 200px; text-align: center;">
                            <label style="display: block; font-size: 13.5px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 8px; text-align: left;">
                                Profile picture
                            </label>
                            <div style="position: relative; width: 170px; height: 170px; margin: 0 auto 12px;">
                                {% if user.avatar_path %}
                                    <img id="avatar-preview" src="{{ user.avatar_path }}" alt="Avatar" style="width: 170px; height: 170px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gh-border-default);">
                                {% else %}
                                    <div id="avatar-placeholder" style="width: 170px; height: 170px; border-radius: 50%; background: #238636; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 64px; border: 2px solid var(--gh-border-default);">
                                        {{ (user.display_name|default(user.username)|first)|upper }}
                                    </div>
                                    <img id="avatar-preview" src="" alt="Avatar" style="display: none; width: 170px; height: 170px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gh-border-default);">
                                {% endif %}
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 8px; align-items: center;">
                                <input type="file" id="avatar-file-input" name="avatar" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display: none;" onchange="previewAvatar(this)">
                                
                                <button type="button" class="gh-btn" onclick="document.getElementById('avatar-file-input').click()" style="width: 170px; font-size: 12.5px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086ZM9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064L11.19 6.25 9.75 4.81Z"></path></svg>
                                    <span>Upload picture</span>
                                </button>

                                {% if user.avatar_path %}
                                    <button type="submit" name="remove_avatar" value="1" class="gh-btn gh-btn-danger" style="width: 170px; font-size: 12px; padding: 4px 8px;" onclick="return confirm('Remove your profile picture?');">
                                        Remove picture
                                    </button>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                </form>

            {# ══════════════════════════════════════════════════════════════ #}
            {# TAB 2: ACCOUNT                                                 #}
            {# ══════════════════════════════════════════════════════════════ #}
            {% elseif active_tab == 'account' %}
                <div style="border-bottom: 1px solid var(--gh-border-default); padding-bottom: 12px; margin-bottom: 24px;">
                    <h1 style="font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">Account settings</h1>
                    <span style="font-size: 13px; color: var(--gh-fg-muted);">Manage your email address and primary account configuration.</span>
                </div>

                {# Email Update Box #}
                <div class="gh-box" style="padding: 20px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-canvas); margin-bottom: 24px;">
                    <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 6px; color: var(--gh-fg-default);">Email address</h2>
                    <p style="font-size: 12.5px; color: var(--gh-fg-muted); margin: 0 0 16px;">
                        Your primary email address is used for security notifications, account recovery, and web-based Git operations.
                    </p>

                    <form method="post" action="/settings/account/email" style="max-width: 480px;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <div style="margin-bottom: 16px;">
                            <label for="acc-email" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                Primary Email
                            </label>
                            <input type="email" id="acc-email" name="email" value="{{ user.email }}" required class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;" dir="ltr">
                        </div>
                        <button type="submit" class="gh-btn gh-btn-primary" style="font-weight: 600; padding: 6px 14px;">
                            Update email
                        </button>
                    </form>
                </div>

                {# Danger Zone Box #}
                <div class="gh-box" style="padding: 20px; border-radius: 6px; border: 1px solid #f85149; background: var(--gh-bg-canvas);">
                    <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 6px; color: #f85149;">Danger Zone</h2>
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; padding-top: 10px;">
                        <div style="max-width: 520px;">
                            <strong style="font-size: 13.5px; color: var(--gh-fg-default); display: block; margin-bottom: 2px;">Delete this account</strong>
                            <span style="font-size: 12.5px; color: var(--gh-fg-muted);">
                                Once you delete your account, there is no going back. All personal repositories, tokens, and data will be permanently erased.
                            </span>
                        </div>
                        <form method="post" action="/settings/account/delete" onsubmit="return confirm('Are you completely sure you want to delete your account? This action is permanent and cannot be undone.');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="gh-btn gh-btn-danger" style="font-weight: 600; padding: 6px 14px;">
                                Delete your account
                            </button>
                        </form>
                    </div>
                </div>

            {# ══════════════════════════════════════════════════════════════ #}
            {# TAB 3: SECURITY & PASSWORD                                     #}
            {# ══════════════════════════════════════════════════════════════ #}
            {% elseif active_tab == 'security' %}
                <div style="border-bottom: 1px solid var(--gh-border-default); padding-bottom: 12px; margin-bottom: 24px;">
                    <h1 style="font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">Password and authentication</h1>
                    <span style="font-size: 13px; color: var(--gh-fg-muted);">Manage your password and security credentials.</span>
                </div>

                {# Change Password Card #}
                <div class="gh-box" style="padding: 20px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-canvas); margin-bottom: 24px;">
                    <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 6px; color: var(--gh-fg-default);">Change password</h2>
                    <p style="font-size: 12.5px; color: var(--gh-fg-muted); margin: 0 0 16px;">
                        Ensure your account is using a strong password with at least 8 characters.
                    </p>

                    <form method="post" action="/settings/account/password" style="max-width: 480px;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        
                        {# Old Password #}
                        <div style="margin-bottom: 16px;">
                            <label for="old-password" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                Old password
                            </label>
                            <input type="password" id="old-password" name="current_password" required autocomplete="current-password" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;" dir="ltr">
                        </div>

                        {# New Password #}
                        <div style="margin-bottom: 16px;">
                            <label for="new-password" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                New password
                            </label>
                            <input type="password" id="new-password" name="password" required minlength="8" autocomplete="new-password" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;" dir="ltr">
                            <span style="font-size: 12px; color: var(--gh-fg-muted); display: block; margin-top: 4px;">Make sure it's at least 8 characters.</span>
                        </div>

                        {# Confirm Password #}
                        <div style="margin-bottom: 20px;">
                            <label for="confirm-password" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">
                                Confirm new password
                            </label>
                            <input type="password" id="confirm-password" name="password_confirm" required minlength="8" autocomplete="new-password" class="gh-form-control" style="width: 100%; font-size: 13.5px; padding: 6px 10px;" dir="ltr">
                        </div>

                        <button type="submit" class="gh-btn gh-btn-primary" style="font-weight: 600; padding: 6px 14px;">
                            Update password
                        </button>
                    </form>
                </div>

                {# Sessions info Card #}
                <div class="gh-box" style="padding: 20px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-canvas);">
                    <div style="display: flex; align-items: flex-start; gap: 12px;">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" style="color: var(--gh-fg-muted); margin-top: 2px;">
                            <path d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-2V3.75a.25.25 0 0 0-.25-.25H2.75a.25.25 0 0 0-.25.25V5.5Z"></path>
                        </svg>
                        <div>
                            <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">Active web session</h2>
                            <span style="font-size: 12.5px; color: var(--gh-fg-muted); line-height: 1.5; display: block;">
                                You are currently authenticated as <strong>@{{ user.username }}</strong>. Updating your password will automatically invalidate other sessions across devices for enhanced security.
                            </span>
                        </div>
                    </div>
                </div>

            {# ══════════════════════════════════════════════════════════════ #}
            {# TAB: REMOTE UPDATES (upd_*)                                    #}
            {# ══════════════════════════════════════════════════════════════ #}
            {% elseif active_tab == 'updates' %}
                <div style="border-bottom: 1px solid var(--gh-border-default); padding-bottom: 12px; margin-bottom: 24px;">
                    <h2 style="font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default); display: flex; align-items: center; gap: 8px;">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" style="color: var(--gh-accent-fg);">
                            <path d="M8.75.75a.75.75 0 0 0-1.5 0v5.59L5.03 4.12a.75.75 0 0 0-1.06 1.06l3.5 3.5a.75.75 0 0 0 1.06 0l3.5-3.5a.75.75 0 0 0-1.06-1.06L8.75 6.34V.75ZM2.75 9.5A1.75 1.75 0 0 0 1 11.25v2c0 .966.784 1.75 1.75 1.75h10.5A1.75 1.75 0 0 0 15 13.25v-2a1.75 1.75 0 0 0-1.75-1.75h-1.5a.75.75 0 0 0 0 1.5h1.5a.25.25 0 0 1 .25.25v2a.25.25 0 0 1-.25.25H2.75a.25.25 0 0 1-.25-.25v-2a.25.25 0 0 1 .25-.25h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path>
                        </svg>
                        <span>{{ t('ui.remote_updates.title') }}</span>
                    </h2>
                    <p style="color: var(--gh-fg-muted); font-size: 13.5px; margin: 0;">
                        {{ t('ui.remote_updates.desc') }}
                    </p>
                </div>

                <div class="gh-box" style="padding: 20px; border-radius: 8px; margin-bottom: 24px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-canvas); box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 14px;">
                        <div>
                            <div style="font-size: 14px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 4px;">
                                🔑 {{ t('ui.remote_updates.token_title') }}
                            </div>
                            <div style="font-size: 12.5px; color: var(--gh-fg-muted); max-width: 540px; line-height: 1.5;">
                                {{ t('ui.remote_updates.token_desc') }}
                            </div>
                        </div>

                        <form method="POST" action="/settings/updates/regenerate-token" onsubmit="return confirm('{{ t_attr('ui.remote_updates.regenerate_confirm') }}');" style="margin: 0;">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="gh-btn gh-btn-sm" style="color: var(--gh-danger-fg); border-color: rgba(207,34,46,0.35); font-weight: 600;">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="margin-inline-end: 4px;"><path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7 7 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A.25.25 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7 7 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/></svg>
                                {{ t('ui.remote_updates.regenerate_btn') }}
                            </button>
                        </form>
                    </div>

                    <div style="display: flex; align-items: center; gap: 8px; background: var(--gh-bg-subtle); padding: 12px 14px; border-radius: 6px; border: 1px solid var(--gh-border-muted);">
                        <code id="user-update-token-val" style="font-family: monospace; font-size: 15px; font-weight: 700; color: #2ea44e; flex: 1; letter-spacing: 0.5px; user-select: all;" dir="ltr">{{ update_token }}</code>
                        <button type="button" class="gh-btn gh-btn-sm" onclick="navigator.clipboard.writeText('{{ update_token }}'); this.textContent = '{{ t_attr('ui.remote_updates.token_copied') }}'; setTimeout(() => this.textContent = '{{ t_attr('ui.remote_updates.copy_token') }}', 1500);" style="font-weight: 600;">
                            {{ t('ui.remote_updates.copy_token') }}
                        </button>
                    </div>

                    <div style="margin-top: 10px; font-size: 12px; color: var(--gh-fg-muted); display: flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1.5a.75.75 0 0 1 0 1.5h-1.5A.75.75 0 0 1 6.5 7.75Zm0 3a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75ZM7.25 4h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5Z"/></svg>
                        <span>{{ t('ui.remote_updates.security_hint') }}</span>
                    </div>
                </div>

                <div class="gh-box" style="padding: 20px; border-radius: 8px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-canvas);">
                    <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 14px 0; color: var(--gh-fg-default);">
                        📋 {{ t('ui.remote_updates.integration_methods') }}
                    </h3>

                    <div style="margin-bottom: 16px;">
                        <div style="font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--gh-fg-default);">
                            {{ t('ui.remote_updates.method_cli_title') }}
                        </div>
                        <div style="background: var(--gh-bg-subtle); padding: 12px; border-radius: 6px; border: 1px solid var(--gh-border-muted); font-family: monospace; font-size: 12px; overflow-x: auto; color: #e6edf3; direction: ltr; text-align: left;">
curl -L -O "{{ app_url }}/d/{short_code}/get/{{ update_token }}"
                        </div>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <div style="font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--gh-fg-default);">
                            {{ t('ui.remote_updates.method_curl_title') }}
                        </div>
                        <div style="background: var(--gh-bg-subtle); padding: 12px; border-radius: 6px; border: 1px solid var(--gh-border-muted); font-family: monospace; font-size: 12px; overflow-x: auto; color: #e6edf3; direction: ltr; text-align: left;">
curl -L -O "{{ app_url }}/{{ user.username }}/{repo}/releases/download/{tag}/{filename}?token={{ update_token }}"
                        </div>
                    </div>

                    <div>
                        <div style="font-weight: 600; font-size: 13px; margin-bottom: 6px; color: var(--gh-fg-default);">
                            {{ t('ui.remote_updates.method_header_title') }}
                        </div>
                        <div style="background: var(--gh-bg-subtle); padding: 12px; border-radius: 6px; border: 1px solid var(--gh-border-muted); font-family: monospace; font-size: 12px; overflow-x: auto; color: #e6edf3; direction: ltr; text-align: left;">
import requests

headers = {"X-Update-Token": "{{ update_token }}"}
res = requests.get("{{ app_url }}/d/{short_code}/get", headers=headers, stream=True)
with open("package.tar.gz", "wb") as f:
    for chunk in res.iter_content(chunk_size=8192):
        f.write(chunk)
                        </div>
                    </div>
                </div>

            {% elseif active_tab == 'keys' %}
                <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--gh-border-default); padding-bottom: 12px; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h1 style="font-size: 20px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">SSH keys</h1>
                        <span style="font-size: 13px; color: var(--gh-fg-muted);">This is a list of SSH keys associated with your account. Remove any keys that you do not recognize.</span>
                    </div>
                    <button type="button" onclick="document.getElementById('add-ssh-key-box').style.display = document.getElementById('add-ssh-key-box').style.display === 'none' ? 'block' : 'none';" class="gh-btn gh-btn-primary" style="font-weight: 600;">
                        New SSH key
                    </button>
                </div>

                {# Add Key Form Box #}
                <div id="add-ssh-key-box" class="gh-box" style="display: none; padding: 20px; margin-bottom: 24px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-subtle);">
                    <h2 style="font-size: 15px; font-weight: 600; margin: 0 0 14px; color: var(--gh-fg-default);">Add an SSH key</h2>
                    <form method="post" action="/settings/keys">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                        <div style="margin-bottom: 14px;">
                            <label for="ssh-title" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">Title</label>
                            <input type="text" id="ssh-title" name="title" placeholder="e.g. Work Laptop, Personal MacBook" class="gh-form-control" style="width: 100%; max-width: 450px;" required>
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label for="ssh-key" style="display: block; font-size: 13px; font-weight: 600; color: var(--gh-fg-default); margin-bottom: 6px;">Key</label>
                            <textarea id="ssh-key" name="public_key" rows="6" placeholder="Begins with 'ssh-rsa', 'ssh-ed25519', or 'ecdsa-sha2-*'" class="gh-form-control" style="width: 100%; font-family: monospace; font-size: 12.5px; resize: vertical;" required></textarea>
                            <span style="font-size: 11.5px; color: var(--gh-fg-muted); display: block; margin-top: 4px;">Paste your public SSH key from <code>~/.ssh/id_ed25519.pub</code> or <code>~/.ssh/id_rsa.pub</code></span>
                        </div>

                        <div style="display: flex; gap: 8px;">
                            <button type="submit" class="gh-btn gh-btn-primary" style="font-weight: 600;">Add SSH key</button>
                            <button type="button" class="gh-btn" onclick="document.getElementById('add-ssh-key-box').style.display = 'none';">Cancel</button>
                        </div>
                    </form>
                </div>

                {# List of Keys #}
                <div class="gh-box" style="border: 1px solid var(--gh-border-default); border-radius: 6px; overflow: hidden; background: var(--gh-bg-canvas);">
                    {% if ssh_keys is defined and ssh_keys|length > 0 %}
                        {% for k in ssh_keys %}
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--gh-border-muted); flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; gap: 12px; align-items: flex-start;">
                                    <div style="padding-top: 2px; color: var(--gh-fg-muted);">
                                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
                                            <path d="M6.5 0A6.5 6.5 0 0 0 0 6.5c0 2.766 1.73 5.127 4.17 6.069l-.67 2.012A.75.75 0 0 0 4.21 15.5h2.58a.75.75 0 0 0 .71-.513l.62-1.859A6.5 6.5 0 0 0 13 6.5 6.5 6.5 0 0 0 6.5 0Zm0 1.5a5 5 0 1 1 0 10 5 5 0 0 1 0-10ZM5 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; font-size: 14px; color: var(--gh-fg-default); margin-bottom: 2px;">
                                            {{ k.title }}
                                        </div>
                                        <div style="font-family: monospace; font-size: 12px; color: var(--gh-fg-muted); margin-bottom: 4px;">
                                            {{ k.fingerprint }}
                                        </div>
                                        <div style="font-size: 11.5px; color: var(--gh-fg-muted);">
                                            Added on {{ k.created_at|date("M d, Y") }}
                                        </div>
                                    </div>
                                </div>
                                <form method="post" action="/settings/keys/{{ k.id }}/delete" onsubmit="return confirm('Are you sure you want to delete this SSH key?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="gh-btn gh-btn-sm" style="color: #cf222e;">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div style="padding: 32px 20px; text-align: center; color: var(--gh-fg-muted);">
                            <svg width="32" height="32" viewBox="0 0 16 16" fill="currentColor" style="opacity: 0.5; margin-bottom: 8px;">
                                <path d="M6.5 0A6.5 6.5 0 0 0 0 6.5c0 2.766 1.73 5.127 4.17 6.069l-.67 2.012A.75.75 0 0 0 4.21 15.5h2.58a.75.75 0 0 0 .71-.513l.62-1.859A6.5 6.5 0 0 0 13 6.5 6.5 6.5 0 0 0 6.5 0Zm0 1.5a5 5 0 1 1 0 10 5 5 0 0 1 0-10ZM5 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"></path>
                            </svg>
                            <p style="margin: 0; font-size: 13.5px; font-weight: 500;">There are no SSH keys associated with your account.</p>
                            <span style="font-size: 12px; display: block; margin-top: 4px;">Add an SSH key to clone and push to your repositories securely over SSH.</span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

        </main>
    </div>
</div>

<style>
@media (max-width: 768px) {
    .gh-settings-sidebar {
        display: none !important;
    }
    .gh-settings-mobile-nav {
        display: block !important;
    }
    .gh-settings-layout {
        flex-direction: column !important;
        gap: 0 !important;
    }
}
</style>

<script>
function previewAvatar(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            var preview = document.getElementById('avatar-preview');
            var placeholder = document.getElementById('avatar-placeholder');
            if (preview) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
            if (placeholder) {
                placeholder.style.display = 'none';
            }
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
{% endblock %}
