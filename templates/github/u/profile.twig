                            <h3 style="font-size: 14px; font-weight: 600; color: var(--gh-fg-default); margin: 0 0 8px 0;">
                                August 2026
                            </h3>
                            <div style="border: 1px solid var(--gh-border-default); border-radius: 6px; padding: 12px 16px; background: var(--gh-bg-subtle); font-size: 13px;">
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                    <span style="color: var(--gh-fg-default); font-weight: 500;">
