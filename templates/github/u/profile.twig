                            <option value="all">Type: All</option>
                            <option value="public">Public</option>
                            <option value="private">Private</option>
                            <option value="fork">Forks</option>
                        </select>

                        <select id="repo-lang-filter" style="padding: 5px 10px; font-size: 13px; background: var(--gh-bg-subtle); color: var(--gh-fg-default); border: 1px solid var(--gh-border-default); border-radius: 6px; outline: none; cursor: pointer;">
                            <option value="all">Language: All</option>
                            {% for lang in languages %}
                                <option value="{{ lang.name|lower }}">{{ lang.name }}</option>
                            {% endfor %}
                        </select>

                        {% if viewer_is_self %}
                            <a href="/repos/new" class="gh-btn gh-btn-primary" style="font-size: 13px; padding: 5px 12px; gap: 6px;">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M7.75 2a.75.75 0 0 1 .75.75V7h4.25a.75.75 0 0 1 0 1.5H8.5v4.25a.75.75 0 0 1-1.5 0V8.5H2.75a.75.75 0 0 1 0-1.5H7V2.75A.75.75 0 0 1 7.75 2Z"/></svg>
                                <span>New</span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                {# Repositories List #}
                <div class="gh-repo-list" id="repo-list-container" style="border-top: 1px solid var(--gh-border-default);">
                    {% for r in repos %}
                        <div class="gh-repo-row"
                             data-name="{{ r.name|lower }}"
                             data-slug="{{ r.slug|lower }}"
                             data-desc="{{ r.description|lower }}"
                             data-visibility="{{ r.visibility }}"
                             data-fork="{{ r.forked_from_id ? 'true' : 'false' }}"
                             data-lang="{{ r.primary_lang|default('')|lower }}"
                             style="padding: 24px 0; border-bottom: 1px solid var(--gh-border-muted, #21262d); display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                                    <a href="/{{ r.display_owner }}/{{ r.slug }}" style="font-size: 20px; font-weight: 600; color: var(--gh-accent-fg, #58a6ff); text-decoration: none; word-break: break-all;">
                                        {{ r.name }}
                                    </a>
                                    <span style="font-size: 12px; font-weight: 500; padding: 1px 7px; border-radius: 10px; border: 1px solid var(--gh-border-default); color: var(--gh-fg-muted); text-transform: capitalize;">
                                        {{ r.visibility }}
                                    </span>
                                </div>

                                {% if r.parent_slug %}
                                    <div style="font-size: 12px; color: var(--gh-fg-muted); margin-bottom: 6px;">
                                        Forked from <a href="/{{ r.parent_slug }}" style="color: var(--gh-accent-fg, #58a6ff); text-decoration: none;">{{ r.parent_slug }}</a>
                                    </div>
                                {% endif %}

                                {% if r.description %}
                                    <p style="font-size: 14px; color: var(--gh-fg-muted); margin: 0 0 12px 0; line-height: 1.5;">
                                        {{ r.description }}
                                    </p>
                                {% endif %}

                                <div style="display: flex; align-items: center; gap: 16px; font-size: 12px; color: var(--gh-fg-muted); flex-wrap: wrap;">
                                    {% if r.primary_lang %}
                                        <span style="display: inline-flex; align-items: center; gap: 5px;">
                                            <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: {{ r.lang_color }};"></span>
                                            <span>{{ r.primary_lang }}</span>
                                        </span>
                                    {% endif %}

                                    {% if (r.stars_count|default(0)) > 0 %}
                                        <span style="display: inline-flex; align-items: center; gap: 4px;">
                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                                            <span>{{ r.stars_count }}</span>
                                        </span>
                                    {% endif %}

                                    {% if (r.forks_count|default(0)) > 0 %}
                                        <span style="display: inline-flex; align-items: center; gap: 4px;">
                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878Zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm3-8.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/></svg>
                                            <span>{{ r.forks_count }}</span>
                                        </span>
                                    {% endif %}

                                    <span>Updated {{ r.updated_at|time_ago }}</span>
                                </div>
                            </div>

                            <div style="flex-shrink: 0;">
                                <a href="/{{ r.display_owner }}/{{ r.slug }}" class="gh-btn gh-btn-sm" style="font-size: 12px; gap: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                                    <span>Star</span>
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div style="padding: 48px 16px; text-align: center; color: var(--gh-fg-muted);">
                            <h3 style="font-size: 18px; color: var(--gh-fg-default); margin: 0 0 8px 0;">{{ profile_name }} doesn’t have any public repositories yet.</h3>
                        </div>
                    {% endfor %}
                </div>

            {# ══════════════════════════════════════════════════════════════════ #}
            {# 3. TAB: STARS                                                   #}
            {# ══════════════════════════════════════════════════════════════════ #}
            {% elseif tab == 'stars' %}

                <div class="gh-stars-list" style="border-top: 1px solid var(--gh-border-default);">
                    {% for r in starred_repos %}
                        <div class="gh-repo-row" style="padding: 24px 0; border-bottom: 1px solid var(--gh-border-muted, #21262d); display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                                    <a href="/{{ r.display_owner }}/{{ r.slug }}" style="font-size: 20px; font-weight: 600; color: var(--gh-accent-fg, #58a6ff); text-decoration: none;">
                                        {{ r.display_owner }}/{{ r.name }}
                                    </a>
                                    <span style="font-size: 12px; font-weight: 500; padding: 1px 7px; border-radius: 10px; border: 1px solid var(--gh-border-default); color: var(--gh-fg-muted); text-transform: capitalize;">
                                        {{ r.visibility }}
                                    </span>
                                </div>

                                {% if r.description %}
                                    <p style="font-size: 14px; color: var(--gh-fg-muted); margin: 0 0 12px 0; line-height: 1.5;">
                                        {{ r.description }}
                                    </p>
                                {% endif %}

                                <div style="display: flex; align-items: center; gap: 16px; font-size: 12px; color: var(--gh-fg-muted); flex-wrap: wrap;">
                                    {% if r.primary_lang %}
                                        <span style="display: inline-flex; align-items: center; gap: 5px;">
                                            <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: {{ r.lang_color }};"></span>
                                            <span>{{ r.primary_lang }}</span>
                                        </span>
                                    {% endif %}
                                    <span>Updated {{ r.updated_at|time_ago }}</span>
                                </div>
                            </div>

                            <div style="flex-shrink: 0;">
                                <a href="/{{ r.display_owner }}/{{ r.slug }}" class="gh-btn gh-btn-sm" style="font-size: 12px; gap: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
                                    <span>Starred</span>
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div style="padding: 48px 16px; text-align: center; color: var(--gh-fg-muted);">
                            <h3 style="font-size: 18px; color: var(--gh-fg-default); margin: 0 0 8px 0;">No starred repositories yet</h3>
                            <p style="font-size: 14px; margin: 0;">Starred repositories will appear here.</p>
                        </div>
                    {% endfor %}
                </div>

            {% endif %}
        </main>
    </div>
</div>

{# Live Follow & Search Script #}
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Interactive Follow/Unfollow Handler
    const followForm = document.getElementById('follow-user-form');
    const followBtn  = document.getElementById('follow-user-btn');
    const followersEl= document.getElementById('followers-count-display');

    if (followForm && followBtn) {
        followForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            followBtn.disabled = true;

            const formData = new FormData(followForm);
            try {
                const res = await fetch(followForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });

                if (res.redirected) {
                    window.location.href = res.url;
                    return;
                }

                const data = await res.json();
                if (data.ok) {
                    if (data.is_following) {
                        followBtn.textContent = 'Unfollow';
                        followBtn.className = 'gh-btn';
                    } else {
                        followBtn.textContent = 'Follow';
                        followBtn.className = 'gh-btn gh-btn-primary';
                    }
                    if (followersEl && data.followers_count !== undefined) {
                        followersEl.textContent = data.followers_count;
                    }
                } else if (data.error) {
                    alert(data.error);
                }
            } catch (err) {
                // Fallback to normal POST submit
                followForm.submit();
            } finally {
                followBtn.disabled = false;
            }
        });
    }

    // 2. Client-side Repository Filter Script
    const searchInput = document.getElementById('repo-search-input');
    const typeFilter  = document.getElementById('repo-type-filter');
    const langFilter  = document.getElementById('repo-lang-filter');
    const rows        = document.querySelectorAll('.gh-repo-row');

    if (searchInput || typeFilter || langFilter) {
        function applyFilters() {
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
            const type  = typeFilter ? typeFilter.value : 'all';
            const lang  = langFilter ? langFilter.value : 'all';

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const slug = row.getAttribute('data-slug') || '';
                const desc = row.getAttribute('data-desc') || '';
                const vis  = row.getAttribute('data-visibility') || '';
                const fork = row.getAttribute('data-fork') || 'false';
                const rLang= row.getAttribute('data-lang') || '';

                const matchesQuery = !query || name.includes(query) || slug.includes(query) || desc.includes(query);

                let matchesType = true;
                if (type === 'public')  matchesType = (vis === 'public');
                if (type === 'private') matchesType = (vis === 'private');
                if (type === 'fork')    matchesType = (fork === 'true');

                let matchesLang = true;
                if (lang !== 'all') matchesLang = (rLang === lang);

                if (matchesQuery && matchesType && matchesLang) {
                    row.style.display = 'flex';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (typeFilter)  typeFilter.addEventListener('change', applyFilters);
        if (langFilter)  langFilter.addEventListener('change', applyFilters);
    }
});
</script>
{% endblock %}
