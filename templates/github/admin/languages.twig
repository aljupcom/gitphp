{% extends "layout.twig" %}

{% block title %}{{ t('adm.languages.title') }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page" style="max-width: 1280px; margin: 0 auto; padding: 24px 16px;">
    {# Page Header #}
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 20px; flex-wrap:wrap; gap:12px; border-bottom: 1px solid var(--gh-border-default); padding-bottom: 16px;">
        <div>
            <h1 style="font-size: 20px; margin: 0 0 4px; font-weight:600; display:flex; align-items:center; gap:8px;">
                <svg class="ti ti-world" style="font-size:22px; color:var(--gh-accent-fg, #58a6ff);"><use href="#ti-world"/></svg>
                <span>{{ t('adm.languages.title') }}</span>
            </h1>
            <p style="color: var(--gh-fg-muted); font-size: 13px; margin: 0;">
                {{ t('adm.languages.description') }}
            </p>
        </div>
    </div>

    <div class="gh-admin-layout" style="display:flex; gap:24px;">
        {% include "partials/admin-nav.twig" with { active: 'languages', counts: nav_counts|default({}) } %}

        <div style="min-width:0; flex: 1;">
            
            {# Flash Messages #}
            {% if flash_success %}
                <div class="gh-alert gh-alert-tip" style="margin-bottom: 16px; padding: 12px 16px; border-radius: 6px; background: rgba(56,139,253,0.1); border: 1px solid rgba(56,139,253,0.4); color: var(--gh-fg-default);">
                    <div style="display:flex; align-items:center; gap:8px; font-weight:600;">
                        <svg class="ti ti-check" style="font-size:18px; color:#3fb950;"><use href="#ti-check"/></svg>
                        <span>{{ flash_success }}</span>
                    </div>
                </div>
            {% endif %}

            {% if flash_error %}
                <div class="gh-alert gh-alert-caution" style="margin-bottom: 16px; padding: 12px 16px; border-radius: 6px; background: rgba(248,81,73,0.1); border: 1px solid rgba(248,81,73,0.4); color: #f85149;">
                    <div style="display:flex; align-items:center; gap:8px; font-weight:600;">
                        <svg class="ti ti-alert-triangle" style="font-size:18px;"><use href="#ti-alert-triangle"/></svg>
                        <span>{{ flash_error }}</span>
                    </div>
                </div>
            {% endif %}

            {# Card 1: Upload New Language Package #}
            <div style="background: var(--gh-bg-subtle); border: 1px solid var(--gh-border-default); border-radius: 6px; padding: 20px; margin-bottom: 24px;">
                <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 8px; display:flex; align-items:center; gap:8px;">
                    <svg class="ti ti-upload" style="font-size:18px; color:var(--gh-accent-fg, #58a6ff);"><use href="#ti-upload"/></svg>
                    <span>{{ t('adm.languages.upload_pack') }}</span>
                </h3>
                <p style="font-size: 13px; color: var(--gh-fg-muted); margin: 0 0 16px;">
                    Upload a ZIP language plugin package containing <code>manifest.json</code> and scoped translation arrays (<code>ui.php</code>, <code>adm.php</code>, <code>common.php</code>).
                </p>

                <form action="/{{ admin_sec_prefix }}/languages/install" method="POST" enctype="multipart/form-data" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                    <input type="file" name="package" accept=".zip" required style="font-size: 13px; background: var(--gh-bg-default); color: var(--gh-fg-default); border: 1px solid var(--gh-border-default); border-radius: 6px; padding: 8px 12px; flex:1; min-width: 240px;">
                    
                    <button type="submit" class="gh-btn gh-btn-primary" style="display:inline-flex; align-items:center; gap:6px; padding: 8px 16px; font-size: 13px; font-weight: 600; background-color: #238636; color: #ffffff; border: 1px solid rgba(240,246,252,0.1); border-radius: 6px; cursor: pointer;">
                        <svg class="ti ti-file-upload" style="font-size:16px;"><use href="#ti-file-upload"/></svg>
                        <span>{{ t('common.btn.upload') }}</span>
                    </button>
                </form>
            </div>

            {# Card 2: Installed Language Packages Table #}
            <div style="background: var(--gh-bg-subtle); border: 1px solid var(--gh-border-default); border-radius: 6px; overflow: hidden;">
                <div style="padding: 14px 16px; border-bottom: 1px solid var(--gh-border-default); background: rgba(255,255,255,0.02); display:flex; justify-content:space-between; align-items:center;">
                    <h3 style="font-size: 14px; font-weight: 600; margin: 0;">
                        {{ t('adm.languages.installed_packages') }} ({{ languages|length }})
                    </h3>
                </div>

                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--gh-border-default); background: var(--gh-bg-default); color: var(--gh-fg-muted);">
                                <th style="padding: 10px 16px; font-weight: 600;">{{ t('adm.languages.code') }}</th>
                                <th style="padding: 10px 16px; font-weight: 600;">{{ t('adm.languages.name') }}</th>
                                <th style="padding: 10px 16px; font-weight: 600;">{{ t('adm.languages.direction') }}</th>
                                <th style="padding: 10px 16px; font-weight: 600;">{{ t('adm.languages.version') }}</th>
                                <th style="padding: 10px 16px; font-weight: 600;">{{ t('adm.languages.status') }}</th>
                                <th style="padding: 10px 16px; font-weight: 600; text-align: right;">{{ t('adm.languages.actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for lang in languages %}
                                <tr style="border-bottom: 1px solid var(--gh-border-default);">
                                    <td style="padding: 12px 16px; font-weight: 600;">
                                        <code style="background: rgba(110,118,129,0.1); padding: 2px 6px; border-radius: 4px;">{{ lang.code }}</code>
                                    </td>
                                    <td style="padding: 12px 16px;">
                                        <div style="font-weight: 600; color: var(--gh-fg-default);">
                                            {{ lang.native_name }}
                                            {% if lang.native_name != lang.name %}
                                                <span style="color: var(--gh-fg-muted); font-size: 12px; font-weight: normal;">({{ lang.name }})</span>
                                            {% endif %}

                                            {% if lang.default %}
                                                <span class="gh-badge" style="background: rgba(56,139,253,0.15); color: #58a6ff; font-size: 11px; margin-left: 6px; border-color: rgba(56,139,253,0.4);">
                                                    {{ t('adm.languages.is_default') }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td style="padding: 12px 16px;">
                                        <span class="gh-badge" style="font-size: 11px; text-transform: uppercase;">
                                            {{ lang.direction }}
                                        </span>
                                    </td>
                                    <td style="padding: 12px 16px; color: var(--gh-fg-muted);">
                                        v{{ lang.version }}
                                    </td>
                                    <td style="padding: 12px 16px;">
                                        {% if lang.active %}
                                            <span style="color: #3fb950; font-weight: 600; display:inline-flex; align-items:center; gap:4px;">
                                                <span style="width:8px; height:8px; border-radius:50%; background:#3fb950; display:inline-block;"></span>
                                                {{ t('common.status.active') }}
                                            </span>
                                        {% else %}
                                            <span style="color: var(--gh-fg-muted); font-weight: 500; display:inline-flex; align-items:center; gap:4px;">
                                                <span style="width:8px; height:8px; border-radius:50%; background:var(--gh-fg-muted); display:inline-block;"></span>
                                                {{ t('common.status.inactive') }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px 16px; text-align: right;">
                                        <div style="display:flex; gap:6px; justify-content:flex-end; align-items:center;">
                                            {% if lang.active %}
                                                {% if current_locale == lang.code %}
                                                    <span class="gh-badge" style="background: rgba(63,185,80,0.15); color: #3fb950; font-size: 11px; padding: 3px 8px; border-color: rgba(63,185,80,0.4); font-weight:600;">
                                                        Active Session
                                                    </span>
                                                {% else %}
                                                    <a href="/lang/{{ lang.code }}" class="gh-btn" style="font-size: 11.5px; padding: 3px 8px; text-decoration:none; display:inline-flex; align-items:center; gap:4px; background-color: #238636; color: #ffffff; border: 1px solid rgba(240,246,252,0.1); font-weight:600;" title="Switch active session language">
                                                        <svg class="ti ti-check" style="font-size:13px;"><use href="#ti-check"/></svg>
                                                        <span>Use Language</span>
                                                    </a>
                                                {% endif %}
                                            {% endif %}
                                            {% if not lang.default %}
                                                <form action="/{{ admin_sec_prefix }}/languages/default" method="POST" style="margin:0;">
                                                    <input type="hidden" name="code" value="{{ lang.code }}">
                                                    <button type="submit" class="gh-btn" style="font-size: 11.5px; padding: 3px 8px;" title="{{ t('adm.languages.set_default') }}">
                                                        {{ t('adm.languages.set_default') }}
                                                    </button>
                                                </form>

                                                <form action="/{{ admin_sec_prefix }}/languages/toggle" method="POST" style="margin:0;">
                                                    <input type="hidden" name="code" value="{{ lang.code }}">
                                                    <button type="submit" class="gh-btn" style="font-size: 11.5px; padding: 3px 8px;">
                                                        {{ lang.active ? t('adm.languages.disable') : t('adm.languages.enable') }}
                                                    </button>
                                                </form>
                                            {% endif %}

                                            <a href="/{{ admin_sec_prefix }}/languages/export/{{ lang.code }}" class="gh-btn" style="font-size: 11.5px; padding: 3px 8px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
                                                <svg class="ti ti-download" style="font-size:13px;"><use href="#ti-download"/></svg>
                                                <span>{{ t('adm.languages.export') }}</span>
                                            </a>

                                            {% if not lang.default and lang.code != 'en' %}
                                                <form action="/{{ admin_sec_prefix }}/languages/delete" method="POST" style="margin:0;" onsubmit="return confirm('Are you sure you want to delete this language package?');">
                                                    <input type="hidden" name="code" value="{{ lang.code }}">
                                                    <button type="submit" class="gh-btn" style="font-size: 11.5px; padding: 3px 8px; color: #f85149;" title="{{ t('adm.languages.delete') }}">
                                                        {{ t('adm.languages.delete') }}
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" style="padding: 24px; text-align: center; color: var(--gh-fg-muted);">
                                        No language packages installed.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
