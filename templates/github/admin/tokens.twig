{% extends "layout.twig" %}

{% block title %}Personal Access Tokens — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page" style="max-width: 1280px; margin: 0 auto; padding: 24px 16px;">
    {# Page Header #}
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 20px; flex-wrap:wrap; gap:12px; border-bottom: 1px solid var(--gh-border-default); padding-bottom: 16px;">
        <div>
            <h1 style="font-size: 20px; margin: 0 0 4px; font-weight:600; color: var(--gh-fg-default);">{{ t('adm.tokens.title')|default('Personal Access Tokens & API Keys') }}</h1>
            <p style="color: var(--gh-fg-muted); font-size: 13px; margin: 0;">
                {{ t('adm.tokens.description')|default('Global audit of all issued API tokens across users. Review scopes, usage, and revoke compromised keys.') }}
            </p>
        </div>
    </div>

    <div class="gh-admin-layout">
        {% include "partials/admin-nav.twig" with { active: 'tokens', counts: nav_counts|default({}) } %}

        <div style="min-width:0; max-width: 860px; flex: 1; width: 100%;">
            
            {% if flash_success %}
                <div class="gh-flash gh-flash-success" role="status" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; background: rgba(46,160,67,0.12); border: 1px solid rgba(46,160,67,0.35); color: #2ea043; font-size: 13.5px;">
                    {{ flash_success }}
                </div>
            {% endif %}
            {% if flash_error %}
                <div class="gh-flash gh-flash-error" role="alert" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; background: rgba(248,81,73,0.12); border: 1px solid rgba(248,81,73,0.35); color: #f85149; font-size: 13.5px;">
                    {{ flash_error }}
                </div>
            {% endif %}

            <div class="gh-box" style="padding: 16px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-default); margin-bottom: 20px;">
                <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 12px; color: var(--gh-fg-default);">
                    {{ t('adm.tokens.issued_tokens', {count: tokens|length})|default('Issued API Tokens (' ~ tokens|length ~ ')') }}
                </h3>

                <div style="overflow-x: auto;">
                    <table class="gh-table" style="width: 100%; font-size: 12.5px; border-collapse: collapse;">
                        <thead>
                            <tr style="background: var(--gh-bg-subtle); border-bottom: 1px solid var(--gh-border-default);">
                                <th style="padding: 8px 10px; text-align: left;">Token Name &amp; User</th>
                                <th style="padding: 8px 10px; text-align: left;">Prefix</th>
                                <th style="padding: 8px 10px; text-align: left;">Scopes</th>
                                <th style="padding: 8px 10px; text-align: left;">Last Used</th>
                                <th style="padding: 8px 10px; text-align: left;">Status</th>
                                <th style="padding: 8px 10px; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for t in tokens %}
                                <tr style="border-bottom: 1px solid var(--gh-border-muted);">
                                    <td style="padding: 10px 8px;">
                                        <div style="font-weight: 600; color: var(--gh-fg-default);">{{ t.name }}</div>
                                        <div style="font-size: 11px; color: var(--gh-fg-muted);">
                                            {% if t.user_id == 0 %}
                                                <span style="color: #e3b341;">👑 Owner</span>
                                            {% else %}
                                                <a href="{{ admin_prefix|default('/admin') }}/users/{{ t.user_id }}" style="color: #58a6ff; text-decoration: none;">@{{ t.username|default('user') }}</a>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <code class="gh-mono" style="font-size: 11.5px;">{{ t.token_prefix|default('ghp_...') }}***</code>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <span class="gh-badge" style="font-size: 11px;">{{ t.scopes|default('repo, read:user') }}</span>
                                    </td>
                                    <td style="padding: 10px 8px; color: var(--gh-fg-muted); font-size: 12px;">
                                        {{ t.last_used_at|default('Never') }}
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        {% if t.revoked_at %}
                                            <span class="gh-badge" style="background: rgba(248,81,73,0.15); color: #f85149; border: 1px solid rgba(248,81,73,0.4); font-size: 11px;">Revoked</span>
                                        {% else %}
                                            <span class="gh-badge" style="background: rgba(46,160,67,0.15); color: #3fb950; border: 1px solid rgba(46,160,67,0.4); font-size: 11px;">Active</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; white-space: nowrap;">
                                        {% if not t.revoked_at %}
                                            <form method="post" action="{{ admin_prefix|default('/admin') }}/tokens/{{ t.id }}/revoke" style="display:inline;" onsubmit="return confirm('Revoke this token immediately?');">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                <button type="submit" class="gh-btn gh-btn-danger" style="padding: 3px 8px; font-size: 11px;">Revoke</button>
                                            </form>
                                        {% else %}
                                            <span style="font-size: 11px; color: var(--gh-fg-muted);">Disabled</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" style="padding: 24px; text-align: center; color: var(--gh-fg-muted);">
                                        No personal access tokens issued yet.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
