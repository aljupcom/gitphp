{% extends "layout.twig" %}

{% block title %}{{ t('adm.sessions.title')|default('Active Sessions') }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page" style="max-width: 1280px; margin: 0 auto; padding: 24px 16px;">
    {# Page Header #}
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 20px; flex-wrap:wrap; gap:12px; border-bottom: 1px solid var(--gh-border-default); padding-bottom: 16px;">
        <div>
            <h1 style="font-size: 20px; margin: 0 0 4px; font-weight:600; color: var(--gh-fg-default);">{{ t('adm.sessions.title')|default('Active Hardware Sessions') }}</h1>
            <p style="color: var(--gh-fg-muted); font-size: 13px; margin: 0;">
                {{ t('adm.sessions.description')|default('Real-time active hardware sessions across all user accounts. Terminate compromised or unauthorized logins.') }}
            </p>
        </div>
    </div>

    <div class="gh-admin-layout">
        {% include "partials/admin-nav.twig" with { active: 'sessions', counts: nav_counts|default({}) } %}

        <div style="min-width:0; max-width: 900px; flex: 1; width: 100%;">
            
            {% if flash_success %}
                <div class="gh-flash gh-flash-success" role="status" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; background: rgba(46,160,67,0.12); border: 1px solid rgba(46,160,67,0.35); color: #2ea043; font-size: 13.5px;">
                    {{ flash_success }}
                </div>
            {% endif %}
            {% if flash_error %}
                <div class="gh-flash gh-flash-error" role="alert" style="margin-bottom: 16px; padding: 10px 14px; border-radius: 6px; background: rgba(248,81,73,0.12); border: 1px solid rgba(248,81,73,0.35); color: #f85149; font-size: 13.5px;">
                    {{ flash_error }}
                </div>
            {% endif %}

            <div class="gh-box" style="padding: 16px; border-radius: 6px; border: 1px solid var(--gh-border-default); background: var(--gh-bg-default); margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
                    <div>
                        <h3 style="font-size: 15px; font-weight: 600; margin: 0 0 4px; color: var(--gh-fg-default);">
                            {{ t('adm.sessions.stream_title', {count: sessions|length})|default('Active Hardware Sessions (' ~ sessions|length ~ ')') }}
                        </h3>
                        <p style="font-size: 12px; color: var(--gh-fg-muted); margin: 0;">
                            {{ t('adm.sessions.stream_desc')|default('Identified devices resolved via Google Play & Apple matrix engines.') }}
                        </p>
                    </div>
                </div>

                <div style="overflow-x: auto;">
                    <table class="gh-table" style="width: 100%; font-size: 12.5px; border-collapse: collapse;">
                        <thead>
                            <tr style="background: var(--gh-bg-subtle); border-bottom: 1px solid var(--gh-border-default);">
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_user')|default('User') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_device')|default('Device & Model') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_location')|default('Location & Country') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_network')|default('Network / ISP') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_ip')|default('IP Address') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_os_browser')|default('OS & Browser') }}</th>
                                <th style="padding: 8px 10px; text-align: left;">{{ t('adm.sessions.th_activity')|default('Last Active') }}</th>
                                <th style="padding: 8px 10px; text-align: right;">{{ t('adm.sessions.th_action')|default('Action') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for s in sessions %}
                                <tr style="border-bottom: 1px solid var(--gh-border-muted);">
                                    <td style="padding: 10px 8px;">
                                        <div style="font-weight: 600; color: var(--gh-fg-default);">
                                            {% if s.user_id == 0 %}
                                                <span style="color: #e3b341;">👑 {{ s.username }}</span>
                                            {% else %}
                                                <a href="{{ admin_prefix|default('/admin') }}/users/{{ s.user_id }}" style="color: #58a6ff; text-decoration: none;">@{{ s.username }}</a>
                                            {% endif %}
                                        </div>
                                        {% if s.is_current %}
                                            <span class="gh-badge" style="background: rgba(46,160,67,0.15); color: #3fb950; font-size: 10px; margin-top: 2px;">{{ t('adm.sessions.current_session')|default('Your Current Session') }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            {% if s.device_type == 'mobile' %}
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="#58a6ff"><path d="M4 1.75C4 .784 4.784 0 5.75 0h4.5C11.216 0 12 .784 12 1.75v12.5A1.75 1.75 0 0 1 10.25 16h-4.5A1.75 1.75 0 0 1 4 14.25ZM5.75 1.5a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h4.5a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25ZM8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
                                            {% elseif s.device_type == 'tablet' %}
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="#a371f7"><path d="M3 1.75C3 .784 3.784 0 4.75 0h6.5C12.216 0 13 .784 13 1.75v12.5A1.75 1.75 0 0 1 11.25 16h-6.5A1.75 1.75 0 0 1 3 14.25ZM4.75 1.5a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h6.5a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25ZM8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
                                            {% else %}
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="#3fb950"><path d="M1.75 2.5h12.5a.25.25 0 0 1 .25.25v7.5a.25.25 0 0 1-.25.25H1.75a.25.25 0 0 1-.25-.25v-7.5a.25.25 0 0 1 .25-.25ZM0 2.75C0 1.784.784 1 1.75 1h12.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 14.25 12H9v1.5h2.25a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1 0-1.5H7V12H1.75A1.75 1.75 0 0 1 0 10.25Zm6 10.75h4v-1.5H6Z"/></svg>
                                            {% endif %}
                                            <strong>{{ s.device_model }}</strong>
                                        </div>
                                        <div style="font-size: 11px; color: var(--gh-fg-muted); margin-top: 2px;">
                                            {{ s.device_brand }} {% if s.device_code and s.device_code != 'N/A' %}· <code>{{ s.device_code }}</code>{% endif %}
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            <span>{{ s.flag_emoji }}</span>
                                            <span style="font-weight: 600; color: var(--gh-fg-default);">
                                                {% if s.country == 'Local Network' %}
                                                    {{ t('adm.sessions.local_network')|default('Local Network') }}
                                                {% else %}
                                                    {{ s.country }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    </td>
                                    <td style="padding: 10px 8px; color: var(--gh-fg-muted); font-size: 11.5px;">
                                        {% if s.as_name == 'Private Network' %}
                                            {{ t('adm.sessions.private_network')|default('Private Network') }}
                                        {% else %}
                                            {{ s.as_name|default('—') }}
                                        {% endif %}
                                    </td>
                                    <td style="padding: 10px 8px;">
                                        <code class="gh-mono" style="font-size: 11.5px;">{{ s.ip_address }}</code>
                                    </td>
                                    <td style="padding: 10px 8px; font-size: 11.5px; color: var(--gh-fg-muted);">
                                        {{ s.os_name }} · {{ s.browser_name }}
                                    </td>
                                    <td style="padding: 10px 8px; color: var(--gh-fg-muted); font-size: 12px; white-space: nowrap;">
                                        {{ s.last_activity }}
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; white-space: nowrap;">
                                        {% if not s.is_current %}
                                            <form method="post" action="{{ admin_prefix|default('/admin') }}/sessions/{{ s.id }}/revoke" style="display:inline;" onsubmit="return confirm('Revoke this session?');">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                <button type="submit" class="gh-btn gh-btn-danger" style="padding: 3px 8px; font-size: 11px;">
                                                    {{ t('adm.sessions.revoke_btn')|default('Revoke') }}
                                                </button>
                                            </form>
                                        {% else %}
                                            <span style="font-size: 11px; color: #3fb950; font-weight:600;">
                                                {{ t('adm.sessions.active_badge')|default('Active') }}
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" style="padding: 24px; text-align: center; color: var(--gh-fg-muted);">
                                        {{ t('adm.sessions.no_sessions')|default('No active sessions found.') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
