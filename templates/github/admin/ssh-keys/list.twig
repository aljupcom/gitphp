{% extends "layout.twig" %}

{% block title %}{{ t('adm.ssh_keys.title')|default('Deploy & SSH Keys') }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="gh-page" style="max-width: 1280px; margin: 0 auto; padding: 24px 16px;">
    {# Header #}
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px; flex-wrap:wrap; gap:12px; border-bottom: 1px solid var(--gh-border-default); padding-bottom: 16px;">
        <div>
            <h1 style="font-size: 20px; margin: 0 0 4px; font-weight:600; color:var(--gh-fg-default);">{{ t('adm.ssh_keys.title')|default('Deploy & Global SSH Keys') }}</h1>
            <p style="color: var(--gh-fg-muted); font-size: 13px; margin: 0;">
                {{ t('adm.ssh_keys.description')|default('Public SSH keys authorized for Git CLI push/pull access across hosted repositories.') }}
            </p>
        </div>
        <div>
            <button type="button" onclick="document.getElementById('modal-add-ssh').style.display='flex';" class="gh-btn gh-btn-primary" style="display:inline-flex; align-items:center; gap:6px; font-weight:600;">
                <svg class="ti ti-plus" style="font-size:15px;"><use href="#ti-plus"/></svg>
                <span>{{ t('adm.ssh_keys.new_key_btn')|default('New SSH Key') }}</span>
            </button>
        </div>
    </div>

    <div class="gh-admin-layout">
        {% include "partials/admin-nav.twig" with { active: 'ssh', counts: nav_counts|default({}) } %}

        <div style="min-width:0; max-width: 860px; flex: 1; width: 100%;">
            
            {# Installed Keys List #}
            <div class="gh-box" style="margin-bottom: 24px; border-radius:6px; border:1px solid var(--gh-border-default); background:var(--gh-bg-default); overflow:hidden;">
                <div class="gh-box-header" style="padding:12px 16px; background:var(--gh-bg-subtle); border-bottom:1px solid var(--gh-border-default); display:flex; justify-content:space-between; align-items:center;">
                    <h2 style="font-size:14px; margin:0; font-weight:600; color:var(--gh-fg-default); display:flex; align-items:center; gap:6px;">
                        <svg class="ti ti-key" style="color:var(--gh-accent);"><use href="#ti-key"/></svg>
                        <span>{{ t('adm.ssh_keys.installed_keys', {count: keys|length})|default('Installed Public Keys (' ~ keys|length ~ ')') }}</span>
                    </h2>
                </div>

                {% if keys|length > 0 %}
                    <div style="padding: 16px; display:flex; flex-direction:column; gap:12px;">
                        {% for key in keys %}
                            <div style="display:flex; justify-content:space-between; align-items:center; border:1px solid var(--gh-border-default); background:var(--gh-bg-subtle); border-radius:6px; padding:14px; flex-wrap:wrap; gap:10px;">
                                <div style="display:flex; align-items:flex-start; gap:12px; min-width:0; flex:1;">
                                    <div style="width:34px; height:34px; border-radius:6px; background:rgba(88,166,255,0.12); color:#58a6ff; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <svg class="ti ti-key" style="font-size:18px;"><use href="#ti-key"/></svg>
                                    </div>
                                    <div style="min-width:0; flex:1;">
                                        <div style="font-weight:600; font-size:13.5px; color:var(--gh-fg-default); word-break:break-word;">{{ key.title|e }}</div>
                                        <div style="font-family:var(--gh-font-mono, monospace); font-size:11px; color:var(--gh-fg-muted); margin:4px 0; word-break:break-all;">
                                            SHA256: {{ key.fingerprint }}
                                        </div>
                                        <div style="font-size:11px; color:var(--gh-fg-muted);">
                                            {{ t('adm.ssh_keys.added_time', {time: key.created_at|time_ago})|default('Added ' ~ key.created_at|time_ago) }}
                                        </div>
                                    </div>
                                </div>
                                <form method="POST" action="{{ admin_prefix|default('/admin') }}/ssh-keys/{{ key.id }}/delete" data-confirm="Are you sure you want to revoke this SSH key immediately?" style="margin:0;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="gh-btn gh-btn-sm" style="color:#f85149; display:inline-flex; align-items:center; gap:4px;" title="{{ t('adm.ssh_keys.revoke_btn')|default('Revoke') }}">
                                        <svg class="ti ti-trash" style="font-size:13px;"><use href="#ti-trash"/></svg>
                                        <span>{{ t('adm.ssh_keys.revoke_btn')|default('Revoke') }}</span>
                                    </button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div style="padding:40px 20px; text-align:center; color:var(--gh-fg-muted);">
                        <svg class="ti ti-key-off" style="font-size:36px; margin-bottom:8px; opacity:0.6;"><use href="#ti-key"/></svg>
                        <p style="font-size:14px; margin:0 0 4px; font-weight:600; color:var(--gh-fg-default);">{{ t('adm.ssh_keys.no_keys')|default('No SSH keys registered') }}</p>
                        <p style="font-size:12.5px; margin:0 0 16px;">{{ t('adm.ssh_keys.no_keys_sub')|default('Add your public key below to authenticate Git operations securely via SSH.') }}</p>
                        <button type="button" onclick="document.getElementById('modal-add-ssh').style.display='flex';" class="gh-btn gh-btn-primary" style="display:inline-flex; align-items:center; gap:6px;">
                            <svg class="ti ti-plus"><use href="#ti-plus"/></svg>
                            <span>{{ t('adm.ssh_keys.new_key_btn')|default('New SSH Key') }}</span>
                        </button>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>
</div>

{# ── MODAL: ADD NEW SSH KEY ────────────────────────────────────────────── #}
<div id="modal-add-ssh" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 1000; align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(4px);">
    <div class="gh-box" style="background: var(--gh-bg-default, #0d1117); border: 1px solid var(--gh-border-default); border-radius: 8px; max-width: 540px; width: 100%; padding: 24px; box-shadow: 0 12px 32px rgba(0,0,0,0.5); animation: rise 0.2s ease-out;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--gh-border-muted); padding-bottom: 10px;">
            <h3 style="font-size: 16px; font-weight: 600; margin: 0; color: var(--gh-fg-default); display: flex; align-items: center; gap: 6px;">
                <svg class="ti ti-key" style="color:var(--gh-accent);"><use href="#ti-key"/></svg>
                <span>{{ t('adm.ssh_keys.modal_title')|default('Add New SSH Key') }}</span>
            </h3>
            <button type="button" onclick="document.getElementById('modal-add-ssh').style.display='none';" style="background:none; border:none; color:var(--gh-fg-muted); font-size:20px; cursor:pointer; padding:0 4px;">&times;</button>
        </div>

        <p style="font-size: 12.5px; color: var(--gh-fg-muted); margin: 0 0 16px; line-height: 1.45;">
            {{ t('adm.ssh_keys.modal_desc')|default('Paste your OpenSSH public key (typically from ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub).') }}
        </p>

        <form method="POST" action="{{ admin_prefix|default('/admin') }}/ssh-keys">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 6px; color: var(--gh-fg-default);" for="ssh-title">
                    {{ t('adm.ssh_keys.label_title')|default('Key Label / Title *') }}
                </label>
                <input type="text" id="ssh-title" name="title" required placeholder="{{ t('adm.ssh_keys.label_title_placeholder')|default('e.g. Work MacBook, Production Server') }}" 
                       style="width: 100%; padding: 8px 12px; font-size: 13px; background: var(--gh-bg-subtle); color: var(--gh-fg-default); border: 1px solid var(--gh-border-default); border-radius: 6px; outline: none; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 6px; color: var(--gh-fg-default);" for="ssh-public-key">
                    {{ t('adm.ssh_keys.public_key_label')|default('Key Content (Public Key) *') }}
                </label>
                <textarea id="ssh-public-key" name="public_key" rows="5" required placeholder="{{ t('adm.ssh_keys.public_key_placeholder')|default('ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... user@host') }}" 
                          style="width: 100%; padding: 8px 12px; font-size: 12px; font-family: var(--gh-font-mono, monospace); background: var(--gh-bg-subtle); color: var(--gh-fg-default); border: 1px solid var(--gh-border-default); border-radius: 6px; outline: none; box-sizing: border-box; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('modal-add-ssh').style.display='none';" class="gh-btn">
                    {{ t('adm.ssh_keys.cancel_btn')|default('Cancel') }}
                </button>
                <button type="submit" class="gh-btn gh-btn-primary" style="font-weight: 600;">
                    <svg class="ti ti-plus"><use href="#ti-plus"/></svg>
                    <span>{{ t('adm.ssh_keys.submit_btn')|default('Add SSH Key') }}</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
